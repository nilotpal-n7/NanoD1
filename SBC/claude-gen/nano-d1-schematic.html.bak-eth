<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nano-D1 — Schematic</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--mask:#14120e;--panel:#201c16;--line:#332d23;--line2:#2a2419;
 --gold:#d4a843;--gold-dim:#8a6f2e;--amber:#e8913c;
 --ink:#ece5d4;--mute:#8d8574;--faint:#5d5749;
 --disp:"Barlow Condensed",Oswald,"Arial Narrow",sans-serif;
 --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}html,body{margin:0;height:100%}
body{background:var(--mask);color:var(--ink);font-family:var(--mono);font-size:13px;
 overflow:hidden;display:grid;grid-template-rows:auto 1fr;height:100vh}
header{display:flex;border-bottom:1px solid var(--line);background:linear-gradient(180deg,#221e17,#191610)}
.brand{padding:9px 16px;border-right:1px solid var(--line);display:flex;flex-direction:column;justify-content:center}
.brand h1{font-family:var(--disp);font-weight:700;font-size:21px;letter-spacing:.06em;margin:0;text-transform:uppercase;color:var(--gold)}
.brand span{font-size:9.5px;color:var(--mute);letter-spacing:.14em;text-transform:uppercase}
.hstat{padding:9px 13px;border-right:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;min-width:62px}
.hstat b{font-family:var(--disp);font-size:18px;font-weight:600;line-height:1}
.hstat b.warn{color:var(--amber)}
.hstat i{font-style:normal;font-size:8.5px;color:var(--mute);letter-spacing:.12em;text-transform:uppercase;margin-top:3px}
.hsearch{flex:1;display:flex;align-items:center;padding:0 13px;gap:8px;min-width:0}
.hsearch input{flex:1;min-width:0;background:#100e0a;border:1px solid var(--line);color:var(--ink);
 font-family:var(--mono);font-size:12px;padding:7px 10px;border-radius:3px;outline:none}
.hsearch input:focus{border-color:var(--gold-dim)}
.hsearch button{background:none;border:1px solid var(--line);color:var(--mute);font-family:var(--mono);
 font-size:10.5px;padding:6px 9px;border-radius:3px;cursor:pointer;white-space:nowrap}
.hsearch button:hover{border-color:var(--gold-dim);color:var(--gold)}
.hsearch button.on{border-color:var(--gold);color:var(--gold);background:#2a2317}
.shell{display:grid;grid-template-columns:184px 1fr 340px;min-height:0}
@media(max-width:1200px){.shell{grid-template-columns:150px 1fr}.inspector{display:none}}
.rail{border-right:1px solid var(--line);background:var(--panel);overflow-y:auto;padding:13px 11px}
.rail h2,.inspector h2{font-family:var(--disp);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--mute);margin:0 0 4px;font-weight:600}
.rail p.sub{font-size:9.5px;color:var(--faint);margin:0 0 11px;line-height:1.55}
.stack{border:1px solid var(--line);border-radius:2px;overflow:hidden;background:#0d0b08}
.sl{display:flex;align-items:center;padding:0 6px;font-size:8.5px;letter-spacing:.05em;color:#0d0b08;font-weight:700}
.sl.di{background:repeating-linear-gradient(45deg,#2a2419,#2a2419 3px,#241f16 3px,#241f16 6px);color:var(--faint);font-weight:400}
.sl.cu{cursor:pointer;transition:filter .15s,opacity .15s}
.sl.cu:hover{filter:brightness(1.25)}.sl.cu.off{opacity:.22;filter:grayscale(1)}
.sl .dk{margin-left:auto;opacity:.72;font-weight:400}
.sl.mask{background:#241f17;color:var(--faint);font-weight:400}
.legend{margin-top:12px;font-size:9px;color:var(--faint);line-height:1.65}
.legend b{color:var(--mute);font-weight:400}
.railnote{margin-top:12px;padding:8px;border:1px solid var(--line);border-left:2px solid var(--amber);
 font-size:9px;line-height:1.6;color:var(--mute);background:#191610;border-radius:2px}
.railnote b{color:var(--amber);font-weight:600}
.canvas{position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 42%,#191510 0%,#0e0c09 100%)}
svg{width:100%;height:100%;display:block;cursor:grab;touch-action:none}
svg.drag{cursor:grabbing}
.hint{position:absolute;left:13px;bottom:11px;font-size:9.5px;color:var(--faint);
 background:rgba(14,12,9,.9);border:1px solid var(--line);padding:5px 9px;border-radius:3px;pointer-events:none}
.zoomer{position:absolute;right:11px;bottom:11px;display:flex;gap:5px}
.zoomer button{width:27px;height:27px;background:rgba(20,18,14,.94);border:1px solid var(--line);
 color:var(--mute);border-radius:3px;cursor:pointer;font-family:var(--mono);font-size:12px}
.zoomer button:hover{color:var(--gold);border-color:var(--gold-dim)}
#tip{position:absolute;pointer-events:none;z-index:20;width:310px;background:#100e0a;
 border:1px solid var(--gold-dim);border-radius:3px;padding:9px 11px;font-size:10.5px;line-height:1.55;
 box-shadow:0 8px 26px rgba(0,0,0,.75);color:var(--ink);opacity:0;transition:opacity .12s}
#tip.on{opacity:1}
#tip.vf{border-color:var(--amber)}
#tip .tr{font-family:var(--disp);font-size:16px;font-weight:600;letter-spacing:.04em;color:var(--gold);line-height:1.1}
#tip .tv{font-size:12px;color:var(--ink);margin-top:1px}
#tip .tm{font-size:9.5px;color:var(--mute);margin-top:3px}
#tip .tn{margin-top:7px;padding-top:6px;border-top:1px solid var(--line);color:#cfc7b3;font-size:10px}
#tip .tvf{margin-top:6px;color:var(--amber);font-size:9.5px}
#tip .tnets{margin-top:6px;font-size:9.5px;color:var(--faint);word-break:break-all}
.board{fill:#191510;stroke:var(--gold-dim);stroke-width:1.4}
.zone rect{fill:rgba(212,168,67,.022);stroke:#3a3226;stroke-width:1;stroke-dasharray:6 6}
.zone text{font-family:var(--disp);font-size:13px;letter-spacing:.2em;fill:#5d5749;text-transform:uppercase}
.comp{cursor:pointer}
.comp rect.body{fill:#221d15;stroke:#4a4032;stroke-width:1.1;transition:stroke .15s,fill .15s}
.comp.soc rect.body{fill:#1d1913;stroke:#5c4f36;stroke-width:1.6}
.comp.pas rect.body{fill:#1e1a13;stroke:#443a2c}
.comp.vf rect.body{stroke:var(--amber);stroke-dasharray:4 2}
.comp text.cname{font-family:var(--disp);font-size:15px;font-weight:600;fill:var(--ink);letter-spacing:.05em}
.comp text.cref{font-family:var(--mono);font-size:8.5px;fill:var(--gold-dim);letter-spacing:.07em}
.comp text.csub{font-family:var(--mono);font-size:7.5px;fill:var(--faint)}
.comp text.pref{font-family:var(--mono);font-size:7.6px;fill:var(--gold-dim)}
.comp text.pval{font-family:var(--mono);font-size:7.6px;fill:#b8b09c}
.comp.vf text.pref{fill:var(--amber)}
.comp.hot rect.body{stroke:var(--gold);fill:#2b2417}
.comp.dim{opacity:.2}
.sym{stroke:#9a8b6a;stroke-width:1.3;fill:none}
.comp.hot .sym{stroke:var(--gold)}
.dnp{stroke:#7a6a4a;stroke-width:1;stroke-dasharray:3 2}
.pinpad{fill:#3a3021;stroke:#6b5a3b;stroke-width:.7;cursor:pointer}
.pinpad.conn{fill:var(--gold-dim);stroke:var(--gold)}
.pinpad.hot{fill:var(--gold);stroke:#fff3d0;stroke-width:1.3}
.pinlbl{font-family:var(--mono);font-size:7.2px;fill:#9a927e;pointer-events:none}
.pinnum{font-family:var(--mono);font-size:6.4px;fill:#6d6553;pointer-events:none}
.pinlbl.hot,.pinnum.hot{fill:var(--gold)}
.wire{fill:none;stroke-width:1.3;opacity:.3;cursor:pointer;transition:opacity .15s,stroke-width .15s}
.wire:hover{opacity:1;stroke-width:2.4}
.wire.hot{opacity:1;stroke-width:2.6;filter:drop-shadow(0 0 5px currentColor)}
.wire.dim{opacity:.04}
.wire.hidden,.jn.hidden,.netlbl.hidden{display:none}
.jn{stroke:none;opacity:.5;transition:opacity .15s}.jn.hot{opacity:1}.jn.dim{opacity:.05}
.netlbl{font-family:var(--mono);font-size:8px;pointer-events:none;opacity:0;transition:opacity .15s}
.netlbl.hot{opacity:1}
.inspector{border-left:1px solid var(--line);background:var(--panel);overflow-y:auto;padding:13px 13px 40px}
.emptyi{color:var(--faint);font-size:10.5px;line-height:1.75;margin-top:5px}
.emptyi b{color:var(--mute);font-weight:500}
.nethead{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-bottom:2px}
.nethead h3{font-family:var(--disp);font-size:25px;font-weight:700;margin:0;letter-spacing:.03em;line-height:1;word-break:break-all}
.chip{font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;padding:3px 6px;border-radius:2px;color:#0d0b08;font-weight:700}
.chip.ghost{background:none;border:1px solid var(--line);color:var(--mute);font-weight:400}
.chip.vf{background:var(--amber)}
.metagrid{margin:11px 0 0;border-top:1px solid var(--line);padding:0}
.metagrid div{display:flex;gap:9px;padding:6px 0;border-bottom:1px solid var(--line2);font-size:10.5px}
.metagrid dt{color:var(--faint);min-width:66px;flex-shrink:0;font-size:9.5px;letter-spacing:.05em;text-transform:uppercase}
.metagrid dd{margin:0;color:var(--ink);line-height:1.5}
.rulebox{margin-top:11px;padding:9px;border:1px solid var(--line);border-left:2px solid currentColor;
 font-size:10px;line-height:1.65;background:#191610;border-radius:2px}
.rulebox strong{display:block;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-bottom:5px;font-weight:600}
.rulebox span{color:#cfc7b3}
.warn{border-left-color:var(--gold)!important}.warn span{color:#f0d89a}
.vfbox{border-left-color:var(--amber)!important;color:var(--amber)!important}
h4.sec{font-family:var(--disp);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin:16px 0 5px;font-weight:600}
.conn,.netlist{list-style:none;margin:0;padding:0}
.conn li,.netlist li{display:flex;gap:7px;align-items:baseline;padding:5px;font-size:10px;
 border-bottom:1px solid var(--line2);cursor:pointer}
.conn li:hover,.netlist li:hover{background:#282217}
.conn li .ref{color:var(--gold);min-width:32px;font-weight:500}
.conn li .pn{color:var(--faint);min-width:22px;text-align:right}
.conn li .nm{color:#cfc7b3;word-break:break-word}
.netlist li .sw{width:8px;height:8px;border-radius:1px;flex-shrink:0}
.netlist li .ct{margin-left:auto;color:var(--faint);font-size:9px}
.bomrow{display:flex;gap:8px;padding:5px 4px;font-size:10px;border-bottom:1px solid var(--line2);align-items:baseline}
.bomrow .v{color:var(--ink);min-width:88px}
.bomrow .q{color:var(--gold-dim);min-width:20px;text-align:right}
.bomrow .d{color:var(--faint);font-size:9px;word-break:break-word}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header>
  <div class="brand"><h1>Nano-D1</h1><span>SG2002 · Schematic rev1</span></div>
  <div class="hstat"><b id="s-comps">—</b><i>Parts</i></div>
  <div class="hstat"><b id="s-nets">—</b><i>Nets</i></div>
  <div class="hstat"><b id="s-pins">—</b><i>Pins</i></div>
  <div class="hstat"><b id="s-vf" class="warn">—</b><i>Verify</i></div>
  <div class="hsearch">
    <input id="q" placeholder="Search nets and parts — try  VDDC   strap   11k8   EPHY" autocomplete="off">
    <button id="tvf">Open items</button>
    <button id="tbom">BOM</button>
    <button id="tpass" class="on">Passives</button>
    <button id="clear">Clear</button>
  </div>
</header>

<div class="shell">
  <aside class="rail">
    <h2>Stackup</h2>
    <p class="sub">1.62 mm · 4L · 1 oz every layer. To scale. Click a copper layer to hide its nets.</p>
    <div class="stack" id="stack"></div>
    <div class="legend" id="legend"></div>
    <div class="railnote"><b>Amber = verify before fab.</b> Three items are unresolved and marked on the parts they affect.</div>
  </aside>
  <div class="canvas">
    <svg id="svg" viewBox="0 0 2600 1500" preserveAspectRatio="xMidYMid meet"></svg>
    <div id="tip"></div>
    <div class="hint">Hover for value and notes · click to trace a net · drag to pan · scroll to zoom · Esc clears</div>
    <div class="zoomer"><button id="zin">+</button><button id="zout">−</button><button id="zfit">⤢</button></div>
  </div>
  <aside class="inspector" id="insp"></aside>
</div>

<script>
const LAYERS={
 1:{name:"L1 Top",color:"#ff7a4d",role:"Signal fanout + GND pour"},
 2:{name:"L2 GND",color:"#5cc07f",role:"Solid ground — unbroken"},
 3:{name:"L3 Power",color:"#cf6ee0",role:"Power shapes (VDDC pour)"},
 4:{name:"L4 Bottom",color:"#4f9fe8",role:"Power distribution + signal"}};
const STACK=[{t:.8,label:"Solder mask",dk:"3.5",kind:"mask"},{t:1.25,label:"L1 TOP",dk:"1 oz",kind:"cu",L:1},
 {t:5,label:"Prepreg",dk:"Dk 4.07",kind:"di"},{t:1.25,label:"L2 GND",dk:"1 oz",kind:"cu",L:2},
 {t:47.2,label:"Core",dk:"Dk 4.0",kind:"di"},{t:1.25,label:"L3 PWR",dk:"1 oz",kind:"cu",L:3},
 {t:5,label:"Prepreg",dk:"Dk 4.07",kind:"di"},{t:1.25,label:"L4 BOTTOM",dk:"1 oz",kind:"cu",L:4},
 {t:.8,label:"Solder mask",dk:"3.5",kind:"mask"}];

const NET={
 GND:{L:2,dom:"0 V",rule:"Pin 1 is audio-local; every other return is the E-pad (89). Reference board uses 39 ground vias at the pad — 27 inside the 6x6 exposed area, 12 in the mask ring. Measured, not estimated."},
 VBUS_5V:{L:3,dom:"5 V",rule:"USB-C sink only. CC1 and CC2 each need their own 5.1k pull-down."},
 VDD3V3:{L:3,dom:"3.3 V",rule:"Gated by PWR_SEQ2 — rises only after 1.8 V. W3 >= 0.5 mm on L3/Bottom, W1 >= 0.4 mm under the SoC.",warn:1},
 VDD1V8:{L:3,dom:"1.8 V",rule:"From the LDO, fanned out through ferrites into four analog domains."},
 VDD1V35:{L:3,dom:"1.35 V",rule:"DDR3L VDDQ, external supply. Three vias sit in the E-pad mask ring at y = -3.600 on the bottom package edge (measured), plus 6 in pin-out and 9 on Bottom. W2 >= 1.5 mm.",warn:1},
 VDDC:{L:3,dom:"0.95 V",rule:"0.95 V for SG2002, not 0.9 V. Size for 1.5 A. Five vias, one per pin, at the pin. On L3 the pour measures 10.0 x 6.2 mm, 24.67 mm2, with a 1.65 mm arm to the regulator and a narrow waist at y = -1.1 crossing under the E-pad.",warn:1},
 VDDC_RTC:{L:3,dom:"internal",rule:"Internal LDO output. Capacitors only — never drive from a supply.",warn:1},
 VDD18A_USB:{L:3,dom:"1.8 V analog",rule:"USB PHY, PLL and Ethernet analog. Ferrite-isolated."},
 WIFI_VDD:{L:3,dom:"3.3 V",rule:"Ferrite plus bulk local to the module. WiFi TX bursts are the noisiest load on the board."},
 USB_DP:{L:1,dom:"USB2",pair:"USB_DM",rule:"90 ohm +/-10%, 0.125 / 0.10 / 0.15 mm. Intra-pair skew under 10 mil. Stitching vias <= 7.5 mm."},
 USB_DM:{L:1,dom:"USB2",pair:"USB_DP",rule:"90 ohm. Series resistor and ESD both at the connector end, not the SoC."},
 USB_DP_C:{L:1,dom:"USB2",rule:"Connector side of the series resistor. ESD taps here; parasitic capacitance under 5 pF."},
 USB_DM_C:{L:1,dom:"USB2",rule:"Connector side of the series resistor."},
 EPHY_TXP:{L:1,dom:"1.8 V analog",pair:"EPHY_TXN",rule:"100 ohm, TOP LAYER ONLY. Shield must reach the pin. Over 40 mm the rule set changes to guarded traces."},
 EPHY_TXN:{L:1,dom:"1.8 V analog",pair:"EPHY_TXP",rule:"100 ohm, top layer only. Package pin is named PAD_ETH_RXM — vendor naming is crossed."},
 EPHY_RXP:{L:1,dom:"1.8 V analog",pair:"EPHY_RXN",rule:"100 ohm, top layer only. Package pin is named PAD_ETH_TXM."},
 EPHY_RXN:{L:1,dom:"1.8 V analog",pair:"EPHY_RXP",rule:"100 ohm, top layer only. Package pin is PAD_ETH_TXP. TX/RX and P/N both inverted — do not correct this.",warn:1},
 XTAL_XIN:{L:1,dom:"1.8 V",rule:"0.25 mm trace, double everything else on the board, per-trace ground shielding. The 1M across XIN/XOUT cannot be omitted.",warn:1},
 XTAL_XOUT:{L:1,dom:"1.8 V",rule:"0.25 mm trace, per-trace ground shield, no high-speed signals underneath."},
 LPO:{L:4,dom:"1.8 V",rule:"32.768 kHz clock for the AP6212's Bluetooth low-power modes. Driven from SoC pin 88 — a 1.8 V pin, matching the module IO domain."},
 WL_LDO_SW:{L:4,dom:"switch node",rule:"AP6212 internal buck switch, pin 21. Reaches pin 23 only through L4. Never tie to a supply rail."},
 WL_LDO_IN:{L:4,dom:"1.8 V",rule:"AP6212 internal buck feedback input, pin 23. L4 from pin 21, C58 to ground."},
 AUD_AVREF:{L:4,dom:"1.8 V analog",rule:"Pin 3, internal audio reference. 1 uF to ground even with audio unused, or the audio block bias is undefined."},
 WIFI_ANT:{L:1,dom:"RF",rule:"50 ohm single-ended: 0.762 mm wide, referenced to L4 not the adjacent plane. All planes cut away beneath.",warn:1},
 SPI_CLK:{L:1,dom:"3.3 V",rule:"The only single-ended net needing individual ground shielding. Bus under 30 mm."},
 SPI_MOSI:{L:1,dom:"3.3 V",rule:"EMMC_DAT0 (pin 22) — boot strap and the flash data line. TRM boot table: SPI NOR = DAT3 down + DAT0 up; SPI NAND = both down; eMMC = both up. Internal defaults are both pull-UP, which selects the eMMC/SD0 controller and is how the card boots.",warn:1},
 SPI_WP:{L:1,dom:"3.3 V",rule:"EMMC_DAT3 (pin 23) — the strap that actually selects the boot device. Pull it DOWN for SPI NOR or NAND; leave it at the internal pull-up for eMMC/SD0. There is no separate SD boot mode: SD0 and eMMC share one controller, so 'eMMC' with a card fitted IS card boot.",warn:1},
 SD0_CLK:{L:4,dom:"3.3 V",rule:"CL under 30 pF is the binding constraint, not frequency. Short traces, one via, no stubs."},
 SD1_CLK:{L:4,dom:"3.3 V",rule:"Keep short — the module sits on the right, matching SD1's package edge."},
 UART0_TX:{L:4,dom:"3.3 V",rule:"BOOT STRAP. The 4.7k pull-up is mandatory; a pull-down puts the chip in ROM fail mode. Reference schematic annotates it 'Do not Delete!!!'.",warn:1},
 UART0_RX:{L:4,dom:"3.3 V",rule:"Debug console, 115200. The reference also pulls RX up through 4.7k."},
 PWR_SEQ2:{L:4,dom:"1.8 V",rule:"Gates the 3.3 V regulator enable — the core of the sequencing scheme. RESOLVED: the ETA3414 EN rising threshold is 1.2 V max and the pin defaults low when floating. VDDIO_RTC is 1.8 V typical, 1.62 V minimum, so there is at least 0.42 V of margin. EN input current is 1-2 uA. No level shift needed.",warn:1},
 VBAT_DET:{L:4,dom:"1.8 V",rule:"30k / 10k from 5 V gives 1.25 V. Shutdown below 1.0 V. Confirmed against the reference netlist. The chip will not start with this floating.",warn:1},
 CPU_SEL:{L:4,dom:"1.8 V",rule:"Boot strap on pin 67. Internal default is PULL-DOWN = Cortex-A53. The reference board leaves this resistor UNPOPULATED and therefore boots ARM. You must populate the pull-up to VDDIO_RTC to get the C906 RISC-V core.",warn:1},
 RESET_N:{L:4,dom:"1.8 V",rule:"10k pull-up plus 100 nF debounce."},
 ZQ_TP:{L:4,dom:"1.8 V",rule:"No external resistor on the reference board (measures 3.9M). Test point only — first thing to probe when DDR init fails."},
 BOB:{L:4,dom:"chassis",rule:"Bob Smith termination node. Common point for the four 75 ohm resistors into the 1 nF / 2 kV chassis cap."},
 CHGND:{L:2,dom:"chassis",rule:"Isolated chassis island under the RJ45, bridged to digital ground by 1M in parallel with 1 nF/2 kV only. No pour under the magnetics."},
 FB_VDDC:{L:4,dom:"feedback",rule:"0.6 V reference. R46/R47 set the core rail. The reference board's divider gives 0.90 V — that is the CV181x value and must NOT be copied.",warn:1},
 FB_3V3:{L:4,dom:"feedback",rule:"0.6 x (100/22.6 + 1) = 3.26 V. Values taken from the reference design."},
 FB_1V35:{L:4,dom:"feedback",rule:"0.6 x (15/12 + 1) = 1.35 V. Values taken from the reference design."}
};
for(let i=0;i<17;i++)NET["HDR18_"+i]={L:4,dom:"1.8 V",rule:"Unused MIPI pin as XGPIOC. 1.8 V domain — a 3.3 V sensor plugged in here damages something. Silkscreen the domain on both sides."};
const inferL=n=>{
 if(n==="GND"||n==="CHGND")return 2;
 if(/^(VDD|VBUS|VCC|WIFI_VDD)/.test(n))return 3;
 if(/^(EPHY|USB_D|SPI_|XTAL|WIFI_ANT|ETH_TX|ETH_RX)/.test(n))return 1;
 return 4;};
const netMeta=n=>NET[n]||{L:inferL(n),dom:"\u2014",rule:"No special constraint — default width and spacing apply."};

const ZONES={
 HDR18:{x:150,y:110,w:540,h:130,t:"Header \u00b7 1.8 V GPIO"},
 ADEC:{x:730,y:110,w:330,h:290,t:"Analog rail decoupling"},
 USB:{x:1100,y:110,w:430,h:290,t:"USB 2.0 \u00b7 Type-C"},
 ETHFE:{x:1580,y:110,w:560,h:400,t:"Ethernet front end"},
 RJ:{x:2190,y:150,w:280,h:300,t:"RJ45"},
 SD:{x:110,y:390,w:230,h:220,t:"microSD"},
 SDP:{x:390,y:370,w:330,h:320,t:"SD0 passives"},
 SOC:{x:790,y:440,w:600,h:540,t:""},
 SD1P:{x:1450,y:560,w:270,h:340,t:"SD1 passives"},
 WIFI:{x:1780,y:600,w:270,h:250,t:"WiFi"},
 ANT:{x:2190,y:620,w:230,h:150,t:"Antenna"},
 NOR:{x:110,y:660,w:230,h:190,t:"SPI NOR"},
 NORP:{x:390,y:740,w:330,h:230,t:"NOR passives"},
