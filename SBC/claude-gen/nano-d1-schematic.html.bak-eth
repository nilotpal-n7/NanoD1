const COMPS=[
 {id:"U1",name:"SG2002",sub:"QFN88 \u00b7 9\u00d79 \u00b7 0.35 mm",zone:"SOC",soc:1,mpn:"SG2002",vf:"Thermal-pad stencil segmentation is unresolved. Never a single 6x6 aperture — target 50-70% coverage in a window-pane array. Confirm with your assembler.",
  note:"RISC-V C906 1 GHz or Cortex-A53, plus a 700 MHz C906 and an 8051. 256 MB DDR3 in-package. Integrated 10/100 EPHY. Pads 0.200 x 0.750 mm, thermal pad 6.000 x 6.000 mm — both confirmed from the vendor package definition.",
  sides:{L:socL,B:socB,R:socR,T:socT}},
 {id:"U2",name:"microSD",sub:"push-pull socket",zone:"SD",mpn:"Molex 5031821852",
  note:"Boot device. 3.3 V fixed — UHS-I is impossible because SD0 shares its IO rail with eMMC.",
  sides:{R:[[1,"CLK","SD0_CLK_SD"],[2,"CMD","SD0_CMD"],[3,"DAT0","SD0_D0"],[4,"DAT1","SD0_D1"],
   [5,"DAT2","SD0_D2"],[6,"DAT3","SD0_D3"],[7,"CD","SD0_CD"],[8,"VDD","VDD3V3"],[9,"VSS","GND"]]}},
 {id:"U3",name:"SPI NOR",sub:"16 MB \u00b7 SOP-8",zone:"NOR",mpn:"W25Q128JVSIQ(1T)",
  note:"On Sophgo's validated flash list; the (1T) suffix is specified. The reference design uses a WSON package rather than SOP-8. To boot from this part instead of the card, fit R14 (pin 23 pull-down). Dropping the part entirely frees six 3.3 V pins.",
  sides:{R:[[1,"CS","SPI_CS"],[2,"SO","SPI_MISO"],[3,"WP","SPI_WP"],[4,"GND","GND"],
   [5,"SI","SPI_MOSI"],[6,"SCK","SPI_CLK_F"],[7,"HOLD","SPI_HOLD"],[8,"VCC","VDD3V3"]]}},
 {id:"U4",name:"WiFi",sub:"SDIO \u00b7 2.4 GHz + BT",zone:"WIFI",mpn:"AP6212 (BCM43438A0)",
  note:"The only SDIO module on Sophgo's validated list with a mainline driver (brcmfmac). Driver support is the real risk here, not the hardware.",
  sides:{L:[[1,"CLK","SD1_CLK_W"],[2,"CMD","SD1_CMD"],[3,"D0","SD1_D0"],[4,"D1","SD1_D1"],
   [5,"D2","SD1_D2"],[6,"D3","SD1_D3"],[7,"REG_ON","WL_REG_ON"],[8,"WAKE","WL_HOST_WAKE"]],
   B:[[9,"VDD","WIFI_VDD"],[10,"GND","GND"]],R:[[11,"ANT","WIFI_ANT"],[12,"LDO_SW","WL_LDO_SW"],[13,"LDO_IN","WL_LDO_IN"],[14,"LPO","LPO"]]}},
 {id:"J1",name:"RJ45",sub:"integrated magnetics",zone:"RJ",mpn:"HanRun HR911105A",
  note:"Reference uses discrete M1601AG magnetics; an integrated-magnetics jack is simpler. Chassis island underneath, bridged to digital GND by 1M in parallel with 1 nF/2 kV. No pour under the magnetics.",
  sides:{L:[[1,"TX+","ETH_TXP_M"],[2,"TX\u2212","ETH_TXN_M"],[3,"RX+","ETH_RXP_M"],[4,"RX\u2212","ETH_RXN_M"],
   [5,"CT","BOB"],[6,"LNK","ETH_LNK_A"],[7,"SPD","ETH_SPD_A"]],B:[[8,"SHLD","CHGND"]]}},
 {id:"J2",name:"USB-C",sub:"16-pin \u00b7 sink",zone:"USB",mpn:"TYPE-C-31-M-12",
  note:"Sink only, no PD. CC1 and CC2 each need their own 5.1k — one shared resistor is a classic fatal error.",
  sides:{B:[[1,"VBUS","VBUS_5V"],[2,"DP","USB_DP_C"],[3,"DM","USB_DM_C"],[4,"CC1","CC1"],[5,"CC2","CC2"],[6,"GND","GND"]]}},
 {id:"D1",name:"ESD",sub:"USB array",zone:"USB",mpn:"USBLC6-2SC6",
  note:"Parasitic capacitance under 5 pF per the design guide. Its ground pin needs a via straight to plane.",
  sides:{L:[[1,"IO1","USB_DP_C"],[2,"IO2","USB_DM_C"]],B:[[3,"GND","GND"]]}},
 {id:"J4",name:"HDR 3V3",sub:"6 spare 3.3 V pins",zone:"IO",
  note:"After SD0, SPI NOR and UART0, only six 3.3 V pins remain on the entire device.",
  sides:{T:[[1,"SCL","I2C0_SCL"],[2,"SDA","I2C0_SDA"],[3,"TMS","JTAG_TMS"],[4,"TCK","JTAG_TCK"],
   [5,"AUX0","GPIO_AUX0"],[6,"SPK","GPIO_A15"],[7,"3V3","VDD3V3"],[8,"GND","GND"]]}},
 {id:"J5",name:"HDR 1V8",sub:"20-pin 2.54 mm",zone:"HDR18",
  note:"17 GPIO in the 1.8 V domain plus one supply and TWO grounds. One return for 17 signals is not enough. Mark the domain in silkscreen on both sides.",
  sides:{B:(function(){var a=[];for(var i=0;i<17;i++)a.push([i+1,"IO"+i,"HDR18_"+i]);
   a.push([18,"1V8","VDD1V8"]);a.push([19,"GND","GND"]);a.push([20,"GND","GND"]);return a;})()}},
 {id:"J3",name:"UART0",sub:"4-pin \u00b7 115200",zone:"IO",
  note:"You will use this constantly. Square pad on pin 1, clear silkscreen, accessible edge.",
  sides:{T:[[1,"GND","GND"],[2,"TX","UART0_TX"],[3,"RX","UART0_RX"],[4,"3V3","VDD3V3"]]}},
 {id:"Y1",name:"XTAL",sub:"25 MHz \u00b7 3225 4-pin",zone:"XTAL",mpn:"25 MHz \u00b130 ppm 12.5 pF",
  note:"Mandatory. 4-pin package with both GND pins bonded to board ground for ESD immunity — confirmed as a real part in the reference BOM. Fully ground-shielded routing.",
  sides:{T:[[1,"XI","XTAL_XIN"],[2,"XO","XTAL_XOUT"]],B:[[3,"G1","GND"],[4,"G2","GND"]]}},
 {id:"E1",name:"u.FL",sub:"RF connector",zone:"ANT",mpn:"IPEX MHF-I",
  note:"A swappable antenna beats a PCB antenna during debug, and the 50 ohm line is only a few mm.",
  sides:{L:[[1,"RF","WIFI_ANT"]],B:[[2,"GND","GND"]]}},
 {id:"U5",name:"BUCK",sub:"3.3 V / 1 A",zone:"REG",mpn:"ETA3414S2F",
  note:"Enable gated by PWR_SEQ2, which drives 1.8 V into a 1.2 V max threshold — verified, no level shift needed. EN defaults low when floating, which is the safe state. 2.6-7 V input, 3 MHz, internal soft-start. Vout = 0.6 x (R1/R2 + 1).",
  sides:{T:[[1,"EN","PWR_SEQ2"],[4,"VIN","VBUS_5V"]],R:[[3,"LX","LX_3V3"],[5,"FB","FB_3V3"]],B:[[2,"GND","GND"]]}},
 {id:"U6",name:"BUCK",sub:"0.95 V / 1.5 A",zone:"REG",mpn:"ETA3414S2F",
  vf:"NO CURRENT HEADROOM. The ETA3414 is rated 1.5 A max with a 1.6 A minimum current limit, and the core budget is about 1.48 A. The reference board does exactly this, but at full NPU load you are at the limit — and output foldbacks to 1.2 A below -25 C. Consider a 2 A+ part for the core rail.",
  note:"Core rail. 1220 mA TPU plus 258 mA core is about 1.5 A. Internal soft-start; sequence so the core leads the 1.8 V LDO. The reference board's divider is set for 0.90 V — that is the CV181x value, not SG2002's.",
  sides:{T:[[1,"EN","VBUS_5V"],[4,"VIN","VBUS_5V"]],R:[[3,"LX","LX_VDDC"],[5,"FB","FB_VDDC"]],B:[[2,"GND","GND"]]}},
 {id:"U7",name:"BUCK",sub:"1.35 V / 1 A",zone:"REG",mpn:"ETA3414S2F",
  note:"DDR3L VDDQ. An LDO here would burn 0.5 W. Enable uses RC soft-start, as the reference does.",
  sides:{T:[[1,"EN","EN_1V35"],[4,"VIN","VBUS_5V"]],R:[[3,"LX","LX_1V35"],[5,"FB","FB_1V35"]],B:[[2,"GND","GND"]]}},
 {id:"U8",name:"LDO",sub:"1.8 V / 300 mA",zone:"REG",mpn:"ETA5050V18S2F",
  note:"Fixed 1.8 V, same part as the reference. Fed from 3.3 V — 1.5 V drop at 150 mA is 0.23 W. Enable uses RC soft-start.",
  sides:{T:[[1,"VIN","VDD3V3"],[3,"EN","EN_1V8"]],R:[[5,"OUT","VDD1V8"]],B:[[2,"GND","GND"]]}}
];

