 ["R24","R","10k 0402","SD1P","WL_REG_ON","GND","Holds the module disabled until software enables it."],
 ["R25","R","10k 0402","SD1P","WL_HOST_WAKE","GND","Host-wake pull-down."],
 ["FB5","FB","600R @100MHz","SD1P","VDD3V3","WIFI_VDD","Isolates the module. WiFi TX bursts are the noisiest load on the board."],
 ["C37","C","10 uF 0603","SD1P","WIFI_VDD","GND","Module bulk, sized for TX current bursts."],
 ["C38","C","100 nF 0402","SD1P","WIFI_VDD","GND","Module bypass."],
 ["L4","L","4.7 uH","SD1P","WL_LDO_SW","WL_LDO_IN","AP6212 internal buck inductor, pins 21 to 23. NOT a bypass — neither pin may touch a supply rail. Murata DFE252010P-4R7M."],
 ["C58","C","10 uF 0603","SD1P","WL_LDO_IN","GND","Internal buck output cap on AP6212 pin 23."],
 ["R26","R","5R1 0402","ETHFE","EPHY_TXP","ETH_TXP_M","Series into the magnetics — surge immunity and EMI. Required. No RC filter on these pairs: it wrecks the eye. Reference uses 5.1R (R3/R5/R12/R13)."],
 ["R27","R","5R1 0402","ETHFE","EPHY_TXN","ETH_TXN_M","Series into the magnetics."],
 ["R28","R","5R1 0402","ETHFE","EPHY_RXP","ETH_RXP_M","Series into the magnetics."],
 ["R29","R","5R1 0402","ETHFE","EPHY_RXN","ETH_RXN_M","Series into the magnetics."],
 ["R30","R","75R 1% 0402","ETHFE","ETH_TXP_M","BOB","Bob Smith termination. Reference uses 75R 1% (R57)."],
 ["R31","R","75R 1% 0402","ETHFE","ETH_TXN_M","BOB","Bob Smith termination."],
 ["R32","R","75R 1% 0402","ETHFE","ETH_RXP_M","BOB","Bob Smith termination."],
 ["R33","R","75R 1% 0402","ETHFE","ETH_RXN_M","BOB","Bob Smith termination."],
 ["C39","C","1 nF 2 kV 1206","ETHFE","BOB","CHGND","High-voltage coupling to chassis ground. Both the voltage rating and the 1206 body matter. Reference uses the same part (C80)."],
 ["R34","R","1M 0402","ETHFE","CHGND","GND","Bleeds the chassis island to digital ground. With C39 this is the entire isolation bridge."],
 ["DA1","D","SMBJ14A","ETHFE","CHGND","GND","Transient suppression on the chassis node. Same part as the reference (DA4)."],
 ["R35","R","1k 0402","ETHFE","ETH_LNK","ETH_LNK_A","Link LED ballast. Driven from a 1.8 V pin — do not size it for 3.3 V."],
 ["R36","R","1k 0402","ETHFE","ETH_SPD","ETH_SPD_A","Speed LED ballast, 1.8 V drive."],
 ["R37","R","5k1 0402","USB","CC1","GND","Type-C sink advertisement. CC1 and CC2 need SEPARATE resistors — sharing one is a classic fatal error."],
 ["R38","R","5k1 0402","USB","CC2","GND","Second, independent CC pull-down."],
 ["R39","R","5R1 0402","USB","USB_DP","USB_DP_C","Series damping at the CONNECTOR end per the design guide, not at the SoC."],
 ["R40","R","5R1 0402","USB","USB_DM","USB_DM_C","Series damping at the connector end."],
 ["R41","R","100k 0402","USB","VBUS_5V","USB_VBUS_DET","Upper leg of the VBUS sense divider — the detect pin is a 1.8 V input."],
 ["R42","R","47k 0402","USB","USB_VBUS_DET","GND","Lower leg. Low means host, high means device."],
 ["C41","C","10 uF 0603","USB","VBUS_5V","GND","Input bulk at the connector."],
 ["C42","C","100 nF 0402","USB","VBUS_5V","GND","Input bypass."],
 ["R43","R","1M 0402","XTAL","XTAL_XIN","XTAL_XOUT","The design guide states this cannot be omitted. Reference uses 1M (R8). Easy to leave off and hard to diagnose."],
 ["C43","C","12 pF NP0","XTAL","XTAL_XIN","GND","Load capacitor. NP0/C0G only — X7R drifts and pulls the frequency. Reference uses 12 pF."],
 ["C44","C","12 pF NP0","XTAL","XTAL_XOUT","GND","Load capacitor, NP0/C0G."],
 ["L1","L","2.2 uH 2 A","REG","LX_3V3","VDD3V3","Keep the input cap to switch node to inductor loop tiny; it is the main EMI source. Reference part: WPN252012H2R2MT."],
 ["R44","R","100k 1% 0402","REG","VDD3V3","FB_3V3","Upper FB leg. 0.6 x (100/22.6 + 1) = 3.26 V. Values lifted from the reference design."],
 ["R45","R","22k6 1% 0402","REG","FB_3V3","GND","Lower FB leg."],
 ["C45","C","22 uF 0805","REG","VBUS_5V","GND","Input bulk for the 3.3 V buck."],
 ["C46","C","22 uF 0603","REG","VDD3V3","GND","Output bulk."],
 ["L2","L","1.0 uH 4 A","REG","LX_VDDC","VDDC","Core rail inductor, rated for 1.5 A continuous with headroom. Reference part: WPN252012H1R0MT."],
 ["R46","R","11k8 1% 0402","REG","VDDC","FB_VDDC","THE critical resistor. 0.6 x (11.8/20 + 1) = 0.954 V. The reference board fits 10k here, giving 0.90 V — that is the CV181x value and must not be copied."],
 ["R47","R","20k 1% 0402","REG","FB_VDDC","GND","Lower FB leg."],
 ["C47","C","22 uF 0805","REG","VBUS_5V","GND","Input bulk for the core buck."],
 ["C48","C","22 uF 0603","REG","VDDC","GND","Core output bulk."],
 ["L3","L","2.2 uH 2 A","REG","LX_1V35","VDD1V35","VDDQ inductor."],
 ["R48","R","15k 1% 0402","REG","VDD1V35","FB_1V35","Upper FB leg. 0.6 x (15/12 + 1) = 1.35 V. Values lifted from the reference design."],
 ["R49","R","12k 1% 0402","REG","FB_1V35","GND","Lower FB leg."],
 ["C49","C","22 uF 0603","REG","VDD1V35","GND","VDDQ output bulk."],
 ["R50","R","33k 0402","REG","VBUS_5V","EN_1V35","RC soft-start on the VDDQ enable, with C50. The reference uses 33k + 1 uF on this exact node."],
 ["C50","C","1 uF 0402","REG","EN_1V35","GND","Soft-start timing cap."],
 ["R51","R","33k 0402","REG","VDD3V3","EN_1V8","RC soft-start on the LDO enable, with C51. Reference uses 33k + 1 uF."],
 ["C51","C","1 uF 0402","REG","EN_1V8","GND","Soft-start timing cap."],
 ["C52","C","4.7 uF 0402","REG","VDD1V8","GND","LDO output capacitor."],
 ["C53","C","100 nF 0402","REG","VDD1V8","GND","LDO output bypass."],
 ["C54","C","22 uF 0805","REG","VBUS_5V","GND","System input bulk at the 5 V entry."],
 ["R52","R","10k 0402","IO","RESET_N","VDD1V8","Reset pull-up."],
 ["C55","C","100 nF 0402","IO","RESET_N","GND","Reset debounce."],
 ["SW1","SW","reset","IO","RESET_N","GND","Momentary. PWR_RSTN, pin 39."],
 ["SW2","SW","boot","IO","BOOT_BTN","GND","PWR_BUTTON1, pin 44 — already internally pulled up."],
 ["R53","R","2k 0402","IO","VDD3V3","LED_PWR_A","Power LED ballast."],
 ["LED1","LED","green 0603","IO","LED_PWR_A","GND","Power indicator."],
 ["R54","R","1k 0402","IO","GPIO_AUX0","LED_USR_A","User LED ballast on a spare 3.3 V pin."],
 ["LED2","LED","green 0603","IO","LED_USR_A","GND","User-controlled indicator."],
 ["TP1","TP","ZQ","IO","ZQ_TP",null,"No external resistor on the reference board. First thing to probe when DDR init fails."],
 ["TP2","TP","SEQ1","IO","SEQ1_TP",null,"Unused in an always-on topology. Test point only."],
 ["TP3","TP","PWM0","IO","PWM0_BUCK",null,"Dynamic VDDC scaling. Reference fits a 40.2k injection resistor but leaves it unpopulated."],
 ["TP4","TP","0.95 V","IO","VDDC",null,"Scope every rail on a slow ramp before the SoC is fitted."],
 ["TP5","TP","1.35 V","IO","VDD1V35",null,"Rail test point."],
 ["TP6","TP","1.8 V","IO","VDD1V8",null,"Rail test point."],
 ["TP7","TP","3.3 V","IO","VDD3V3",null,"Rail test point — verify it rises only AFTER 1.8 V."],
 ["TP8","TP","5 V","IO","VBUS_5V",null,"Input rail test point."]
];

const PW=64,PH=30,PGAP=14,packer={};
function place(zone,w,h){
 const z=ZONES[zone];
 const st=packer[zone]||(packer[zone]={x:z.x+14,y:z.y+34,rowH:0});
 if(st.x+w>z.x+z.w-10){st.x=z.x+14;st.y+=st.rowH+PGAP;st.rowH=0;}
 const p={x:st.x,y:st.y};st.x+=w+PGAP;st.rowH=Math.max(st.rowH,h);return p;
}
COMPS.forEach(c=>{
 if(!c.zone)return;const z=ZONES[c.zone];
 if(c.soc){c.x=z.x;c.y=z.y;c.w=z.w;c.h=z.h;return;}
 const w=Math.min(z.w-28,190),h=110,p=place(c.zone,w,h);
 c.x=p.x;c.y=p.y;c.w=w;c.h=h;
});
PASS.forEach(function(row){
 const p=place(row[3],PW,PH);
 const c={id:row[0],kind:row[1],value:row[2],zone:row[3],note:row[6],passive:1,
   dnp:/DNP/.test(row[2]),fit:/FIT/.test(row[2]),
   x:p.x,y:p.y,w:PW,h:PH,sides:{L:[[1,"",row[4]]]}};
 if(row[5])c.sides.R=[[2,"",row[5]]];
 if(c.fit)c.vf="Populate this — the reference board leaves it empty and boots the wrong core.";
 COMPS.push(c);
});

const DIRS={L:[-1,0],R:[1,0],T:[0,-1],B:[0,1]};
const pinIndex={},nets={};
COMPS.forEach(c=>{
 c.pins=[];
 Object.keys(c.sides||{}).forEach(side=>{
  const arr=c.sides[side],n=arr.length;if(!n)return;
  const horiz=(side==="L"||side==="R");
  const span=horiz?c.h:c.w,start=horiz?c.y:c.x,step=span/(n+1);
  arr.forEach((p,i)=>{
   const o=start+step*(i+1);let x,y;
   if(side==="L"){x=c.x;y=o;}else if(side==="R"){x=c.x+c.w;y=o;}
   else if(side==="T"){x=o;y=c.y;}else{x=o;y=c.y+c.h;}
   const pin={comp:c,ref:c.id,num:p[0],name:p[1],net:p[2],side:side,x:x,y:y,dir:DIRS[side]};
   c.pins.push(pin);pinIndex[c.id+"."+p[0]]=pin;
   if(p[2])(nets[p[2]]=nets[p[2]]||[]).push(pin);
  });
 });
});

const hash=s=>{let h=0;for(let i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))|0;return h;};
const ESC=20;
function routeNet(name,pins){
 const esc=pins.map(p=>({p:p,x:p.x+p.dir[0]*ESC,y:p.y+p.dir[1]*ESC}));
 const med=a=>{const s=a.slice().sort((u,v)=>u-v);return s[Math.floor(s.length/2)];};
 const h=Math.abs(hash(name));
 const hub={x:med(esc.map(e=>e.x))+((h%11)-5)*8,y:med(esc.map(e=>e.y))+(((h>>5)%11)-5)*8};
 return {segs:esc.map(e=>{
  const horiz=e.p.dir[0]!==0;
  const bx=horiz?hub.x:e.x,by=horiz?e.y:hub.y;
  return "M"+e.p.x+" "+e.p.y+" L"+e.x+" "+e.y+" L"+bx+" "+by+" L"+hub.x+" "+hub.y;}),hub:hub};
}

const NS="http://www.w3.org/2000/svg";
const svg=document.getElementById("svg");
const el=(t,a)=>{const n=document.createElementNS(NS,t);for(const k in(a||{}))n.setAttribute(k,a[k]);return n;};
const gRoot=el("g"),gBoard=el("g"),gZone=el("g"),gWires=el("g"),gComps=el("g"),gLbls=el("g");
gRoot.append(gBoard,gZone,gWires,gComps,gLbls);svg.append(gRoot);
gBoard.append(el("rect",{class:"board",x:50,y:50,width:2500,height:1400,rx:16}));
gBoard.append(el("rect",{fill:"none",stroke:"#2a2419","stroke-width":1,"stroke-dasharray":"5 5",x:70,y:70,width:2460,height:1360,rx:10}));
[[84,64],[2516,64],[84,1436],[2516,1436]].forEach(p=>
 gBoard.append(el("circle",{cx:p[0],cy:p[1],r:10,fill:"none",stroke:"#3a3226","stroke-width":1.2})));
for(let x=170;x<2440;x+=38){
 gBoard.append(el("circle",{cx:x,cy:50,r:5,fill:"#0e0c09",stroke:"#8a6f2e","stroke-width":1}));
 gBoard.append(el("circle",{cx:x,cy:1450,r:5,fill:"#0e0c09",stroke:"#8a6f2e","stroke-width":1}));
}
const bt=el("text",{x:72,y:40,fill:"#5d5749","font-size":12,"letter-spacing":"0.2em"});
bt.textContent="NANO-D1  \u00b7  65 \u00d7 30 mm  \u00b7  4-LAYER  \u00b7  MATTE BLACK + ENIG";gBoard.append(bt);
Object.keys(ZONES).forEach(k=>{
 const z=ZONES[k];if(!z.t)return;
 const g=el("g",{class:"zone"});
 g.append(el("rect",{x:z.x,y:z.y,width:z.w,height:z.h,rx:5}));
 const t=el("text",{x:z.x+10,y:z.y+18});t.textContent=z.t;g.append(t);gZone.append(g);
});
const wireEls={};
Object.keys(nets).forEach(name=>{
 const pins=nets[name];if(pins.length<2)return;
 const m=netMeta(name),col=LAYERS[m.L].color,r=routeNet(name,pins),arr=[];
 r.segs.forEach(d=>{const p=el("path",{class:"wire",d:d,stroke:col,"data-net":name});gWires.append(p);arr.push(p);});
 if(pins.length>2){const j=el("circle",{class:"jn",cx:r.hub.x,cy:r.hub.y,r:3.4,fill:col,"data-net":name});gWires.append(j);arr.push(j);}
 const t=el("text",{class:"netlbl",x:r.hub.x+7,y:r.hub.y-6,fill:col,"data-net":name});t.textContent=name;gLbls.append(t);arr.push(t);
 wireEls[name]=arr;
});
function symbol(c,g){
 const cx=c.x+c.w/2,cy=c.y+c.h/2;
 const S=(t,a)=>{a.class="sym";g.append(el(t,a));};
 if(c.kind==="C"){S("line",{x1:cx-4,y1:cy-8,x2:cx-4,y2:cy+8});S("line",{x1:cx+4,y1:cy-8,x2:cx+4,y2:cy+8});
  S("line",{x1:c.x,y1:cy,x2:cx-4,y2:cy});S("line",{x1:cx+4,y1:cy,x2:c.x+c.w,y2:cy});}
 else if(c.kind==="R"){S("rect",{x:cx-14,y:cy-6,width:28,height:12,rx:1});
  S("line",{x1:c.x,y1:cy,x2:cx-14,y2:cy});S("line",{x1:cx+14,y1:cy,x2:c.x+c.w,y2:cy});}
 else if(c.kind==="L"||c.kind==="FB"){
  S("path",{d:"M"+(cx-15)+" "+cy+" q4 -9 8 0 q4 -9 8 0 q4 -9 8 0 q4 -9 8 0"});
  if(c.kind==="FB")S("rect",{x:cx-17,y:cy-10,width:34,height:15,rx:2,"stroke-dasharray":"3 2"});
  S("line",{x1:c.x,y1:cy,x2:cx-15,y2:cy});S("line",{x1:cx+17,y1:cy,x2:c.x+c.w,y2:cy});}
 else if(c.kind==="D"||c.kind==="LED"){
  S("path",{d:"M"+(cx-7)+" "+(cy-7)+" L"+(cx+6)+" "+cy+" L"+(cx-7)+" "+(cy+7)+" Z"});
  S("line",{x1:cx+6,y1:cy-7,x2:cx+6,y2:cy+7});
  S("line",{x1:c.x,y1:cy,x2:cx-7,y2:cy});S("line",{x1:cx+6,y1:cy,x2:c.x+c.w,y2:cy});
  if(c.kind==="LED"){S("line",{x1:cx+2,y1:cy-10,x2:cx+8,y2:cy-15});S("line",{x1:cx+7,y1:cy-8,x2:cx+13,y2:cy-13});}}
 else if(c.kind==="SW"){S("line",{x1:c.x,y1:cy,x2:cx-8,y2:cy});S("line",{x1:cx-8,y1:cy,x2:cx+6,y2:cy-9});
  S("line",{x1:cx+8,y1:cy,x2:c.x+c.w,y2:cy});S("circle",{cx:cx-8,cy:cy,r:1.8});S("circle",{cx:cx+8,cy:cy,r:1.8});}
 else if(c.kind==="TP"){S("circle",{cx:cx,cy:cy,r:6});S("line",{x1:c.x,y1:cy,x2:cx-6,y2:cy});}
 if(c.dnp){g.append(el("line",{class:"dnp",x1:cx-16,y1:cy-11,x2:cx+16,y2:cy+11}));
          g.append(el("line",{class:"dnp",x1:cx-16,y1:cy+11,x2:cx+16,y2:cy-11}));}
}
COMPS.forEach(c=>{
 const g=el("g",{class:"comp"+(c.soc?" soc":"")+(c.passive?" pas":"")+(c.vf?" vf":""),"data-comp":c.id});
 g.append(el("rect",{class:"body",x:c.x,y:c.y,width:c.w,height:c.h,rx:c.passive?2:4}));
 if(c.passive){
  symbol(c,g);
  const r=el("text",{class:"pref",x:c.x+2,y:c.y-3});r.textContent=c.id;g.append(r);
  const v=el("text",{class:"pval",x:c.x+2,y:c.y+c.h+9});v.textContent=c.value;g.append(v);
 }else{
  const cx=c.x+c.w/2,cy=c.y+c.h/2;
  const rf=el("text",{class:"cref",x:cx,y:cy-22,"text-anchor":"middle"});rf.textContent=c.id;
  const nm=el("text",{class:"cname",x:cx,y:cy-4,"text-anchor":"middle"});nm.textContent=c.name;
  const sb=el("text",{class:"csub",x:cx,y:cy+12,"text-anchor":"middle"});sb.textContent=c.sub;
  g.append(rf,nm,sb);
 }
 c.pins.forEach(p=>{
  const horiz=p.dir[0]!==0,pw=horiz?8:4,ph=horiz?4:8;
  g.append(el("rect",{class:"pinpad"+(p.net?" conn":""),x:p.x-pw/2,y:p.y-ph/2,width:pw,height:ph,rx:1,
   "data-net":p.net||"","data-pin":c.id+"."+p.num}));
  if(p.name&&!c.passive){
   const ox=p.dir[0]*12,oy=p.dir[1]*12;
   const anc=p.side==="L"?"end":p.side==="R"?"start":"middle";
   const lb=el("text",{class:"pinlbl",x:p.x+ox,y:p.y+oy+(horiz?2.5:(p.dir[1]<0?0:6)),"text-anchor":anc,
    "data-pinlbl":c.id+"."+p.num});
   if(!horiz)lb.setAttribute("transform","rotate(-90 "+(p.x+ox)+" "+(p.y+oy)+")");
   lb.textContent=p.name;g.append(lb);
  }
  if(c.soc){const ix=-p.dir[0]*9,iy=-p.dir[1]*9;
   const nn=el("text",{class:"pinnum",x:p.x+ix,y:p.y+iy+2.2,"text-anchor":"middle","data-pinnum":c.id+"."+p.num});
   nn.textContent=p.num;g.append(nn);}
 });
 gComps.append(g);
});

const total=STACK.reduce((s,l)=>s+l.t,0),PX=340;
const stackEl=document.getElementById("stack");
STACK.forEach(l=>{
 const d=document.createElement("div");
 d.className="sl "+l.kind;
 d.style.height=Math.max(13,(l.t/total)*PX)+"px";
 if(l.kind==="cu")d.style.background=LAYERS[l.L].color;
 d.innerHTML='<span>'+l.label+'</span><span class="dk">'+l.dk+'</span>';
 if(l.kind==="cu"){d.tabIndex=0;d.setAttribute("role","button");
  d.setAttribute("aria-label","Toggle "+LAYERS[l.L].name);
  const t=()=>toggleLayer(l.L,d);d.onclick=t;
  d.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();t();}};}
 stackEl.append(d);
});
document.getElementById("legend").innerHTML=Object.keys(LAYERS).map(k=>{
 const v=LAYERS[k];
 return '<div><b style="color:'+v.color+'">\u25a0</b> <b>'+v.name+'</b> \u2014 '+v.role+'</div>';}).join("");
const off=new Set();
function toggleLayer(L,node){
 off.has(L)?off.delete(L):off.add(L);
 node.classList.toggle("off",off.has(L));
 Object.keys(nets).forEach(n=>{
  if(netMeta(n).L===L)(wireEls[n]||[]).forEach(e=>e.classList.toggle("hidden",off.has(L)));});
}

const tip=document.getElementById("tip"),cv=document.querySelector(".canvas");
const esc=s=>String(s).replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
function showTip(html,e,vf){
 tip.innerHTML=html;tip.classList.add("on");tip.classList.toggle("vf",!!vf);
 const r=cv.getBoundingClientRect();
 let x=e.clientX-r.left+16,y=e.clientY-r.top+16;
 if(x+322>r.width)x=Math.max(6,e.clientX-r.left-326);
 if(y+tip.offsetHeight>r.height)y=Math.max(6,r.height-tip.offsetHeight-8);
 tip.style.left=x+"px";tip.style.top=y+"px";
}
const hideTip=()=>tip.classList.remove("on");
svg.addEventListener("pointermove",e=>{
 if(drag){hideTip();return;}
 const t=e.target;
 if(t.dataset&&t.dataset.pin){
  const p=pinIndex[t.dataset.pin],m=p.net?netMeta(p.net):null;
  return showTip('<div class="tr">'+esc(p.ref)+' \u00b7 pin '+p.num+'</div>'+
   '<div class="tv">'+esc(p.name||p.comp.value||"\u2014")+'</div>'+
   (p.net?'<div class="tm" style="color:'+LAYERS[m.L].color+'">'+esc(p.net)+' \u00b7 '+LAYERS[m.L].name+'</div>':'<div class="tm">not connected</div>')+
   (m&&m.rule?'<div class="tn">'+esc(m.rule)+'</div>':'')+
   (m&&m.vf?'<div class="tvf">VERIFY \u2014 '+esc(m.vf)+'</div>':''),e,m&&m.vf);
 }
 if(t.dataset&&t.dataset.net){
  const n=t.dataset.net,m=netMeta(n);
  return showTip('<div class="tr" style="color:'+LAYERS[m.L].color+'">'+esc(n)+'</div>'+
   '<div class="tv">'+LAYERS[m.L].name+' \u00b7 '+esc(m.dom)+'</div>'+
   '<div class="tn">'+esc(m.rule)+'</div>'+
   (m.vf?'<div class="tvf">VERIFY \u2014 '+esc(m.vf)+'</div>':'')+
   '<div class="tnets">'+nets[n].length+' nodes \u2014 click to trace</div>',e,m.vf);
 }
 const g=t.closest&&t.closest(".comp");
 if(g){
  const c=COMPS.filter(x=>x.id===g.dataset.comp)[0];
  if(c)return showTip('<div class="tr">'+esc(c.id)+'</div>'+
   '<div class="tv">'+esc(c.value||c.name)+'</div>'+
   (c.mpn?'<div class="tm">'+esc(c.mpn)+'</div>':(c.sub?'<div class="tm">'+esc(c.sub)+'</div>':''))+
   (c.note?'<div class="tn">'+esc(c.note)+'</div>':'')+
   (c.vf?'<div class="tvf">VERIFY \u2014 '+esc(c.vf)+'</div>':'')+
   '<div class="tnets">'+c.pins.filter(p=>p.net).map(p=>esc(p.net)).join(" \u00b7 ")+'</div>',e,c.vf);
 }
 hideTip();
});
svg.addEventListener("pointerleave",hideTip);

const insp=document.getElementById("insp");
function clearSel(){document.querySelectorAll(".hot,.dim").forEach(e=>e.classList.remove("hot","dim"));renderEmpty();}
function selectNet(name){
 if(!nets[name])return;
 document.querySelectorAll(".hot,.dim").forEach(e=>e.classList.remove("hot","dim"));
 const pins=nets[name],comps=new Set(pins.map(p=>p.ref));
 document.querySelectorAll(".wire,.jn,.netlbl").forEach(e=>e.classList.add(e.dataset.net===name?"hot":"dim"));
 document.querySelectorAll(".comp").forEach(g=>g.classList.add(comps.has(g.dataset.comp)?"hot":"dim"));
 pins.forEach(p=>{const k=p.ref+"."+p.num;
  ["pin","pinlbl","pinnum"].forEach(a=>{
   const n=document.querySelector('[data-'+a+'="'+k+'"]');if(n)n.classList.add("hot");});});
 renderNet(name);
}
function selectComp(id){
 const c=COMPS.filter(x=>x.id===id)[0];if(!c)return;
 document.querySelectorAll(".hot,.dim").forEach(e=>e.classList.remove("hot","dim"));
 const ns=new Set(c.pins.map(p=>p.net).filter(Boolean));
 document.querySelectorAll(".comp").forEach(g=>g.classList.add(g.dataset.comp===id?"hot":"dim"));
 document.querySelectorAll(".wire,.jn,.netlbl").forEach(e=>e.classList.add(ns.has(e.dataset.net)?"hot":"dim"));
 renderComp(c,ns);
}
function renderNet(name){
 const m=netMeta(name),lay=LAYERS[m.L],pins=nets[name];
 const parts=new Set(pins.map(p=>p.ref));
 insp.innerHTML='<div class="nethead"><h3 style="color:'+lay.color+'">'+esc(name)+'</h3>'+
  '<span class="chip" style="background:'+lay.color+'">'+lay.name+'</span>'+
  '<span class="chip ghost">'+esc(m.dom)+'</span>'+(m.vf?'<span class="chip vf">verify</span>':'')+'</div>'+
  '<dl class="metagrid"><div><dt>Layer</dt><dd>'+lay.name+' \u2014 '+lay.role+'</dd></div>'+
  '<div><dt>Nodes</dt><dd>'+pins.length+' pins \u00b7 '+parts.size+' parts</dd></div>'+
  (m.pair?'<div><dt>Pair</dt><dd style="cursor:pointer;color:'+lay.color+'" data-goto="'+m.pair+'">'+esc(m.pair)+' \u2197</dd></div>':'')+
  '</dl><div class="rulebox '+(m.warn?"warn":"")+'" style="color:'+lay.color+'">'+
  '<strong>'+(m.warn?"Critical constraint":"Design rule")+'</strong><span>'+esc(m.rule)+'</span></div>'+
  (m.vf?'<div class="rulebox vfbox"><strong>Open item</strong><span>'+esc(m.vf)+'</span></div>':'')+
  '<h4 class="sec">Nodes</h4><ul class="conn">'+pins.map(p=>
   '<li data-goto-comp="'+p.ref+'"><span class="ref">'+p.ref+'</span><span class="pn">'+p.num+'</span>'+
   '<span class="nm">'+esc(p.name||p.comp.value||"")+'</span></li>').join("")+'</ul>';
 wireUp();
}
function renderComp(c,ns){
 insp.innerHTML='<div class="nethead"><h3 style="color:var(--gold)">'+esc(c.value||c.name)+'</h3>'+
  '<span class="chip ghost">'+esc(c.id)+'</span>'+(c.vf?'<span class="chip vf">verify</span>':'')+'</div><dl class="metagrid">'+
  (c.mpn?'<div><dt>Part</dt><dd>'+esc(c.mpn)+'</dd></div>':'')+
  (c.sub?'<div><dt>Package</dt><dd>'+esc(c.sub)+'</dd></div>':'')+
  '<div><dt>Zone</dt><dd>'+esc((ZONES[c.zone]||{}).t||c.zone||"\u2014")+'</dd></div>'+
  '<div><dt>Pins</dt><dd>'+c.pins.length+' \u00b7 '+ns.size+' net'+(ns.size===1?'':'s')+'</dd></div></dl>'+
  (c.note?'<div class="rulebox" style="color:var(--gold)"><strong>Note</strong><span>'+esc(c.note)+'</span></div>':'')+
  (c.vf?'<div class="rulebox vfbox"><strong>Open item</strong><span>'+esc(c.vf)+'</span></div>':'')+
  '<h4 class="sec">Pinout</h4><ul class="conn">'+c.pins.map(p=>{
   const m=p.net?netMeta(p.net):null;
   return '<li '+(p.net?'data-goto="'+p.net+'"':'')+'><span class="pn">'+p.num+'</span>'+
    '<span class="nm">'+esc(p.name||"")+'</span><span class="ref" style="margin-left:auto;color:'+
    (p.net?LAYERS[m.L].color:"var(--faint)")+'">'+esc(p.net||"NC")+'</span></li>';}).join("")+'</ul>';
 wireUp();
}
function renderEmpty(){
 const order=Object.keys(nets).filter(n=>nets[n].length>1).sort((a,b)=>nets[b].length-nets[a].length);
 insp.innerHTML='<h2>Inspector</h2><p class="emptyi">Hover anything for its <b>value, part number and note</b>. '+
  'Click a pin, wire or part to trace a net.<br><br>Wire colour is the copper layer. '+
  '<b style="color:var(--amber)">Amber</b> marks the three items still to verify before fab.</p>'+
  '<h4 class="sec">All nets \u2014 '+order.length+'</h4><ul class="netlist">'+order.map(n=>{
   const m=netMeta(n);
   return '<li data-goto="'+n+'"><span class="sw" style="background:'+LAYERS[m.L].color+'"></span>'+
    esc(n)+'<span class="ct">'+nets[n].length+'</span></li>';}).join("")+'</ul>';
 wireUp();
}
function wireUp(){
 insp.querySelectorAll("[data-goto]").forEach(e=>e.onclick=()=>selectNet(e.dataset.goto));
 insp.querySelectorAll("[data-goto-comp]").forEach(e=>e.onclick=()=>selectComp(e.dataset.gotoComp));
}
svg.addEventListener("click",e=>{
 const t=e.target;
 if(t.dataset&&t.dataset.net)return selectNet(t.dataset.net);
 if(t.dataset&&t.dataset.pin){const p=pinIndex[t.dataset.pin];if(p&&p.net)return selectNet(p.net);}
 const g=t.closest&&t.closest(".comp");
 if(g)return selectComp(g.dataset.comp);
 clearSel();
});
document.addEventListener("keydown",e=>{if(e.key==="Escape")clearSel();});
document.getElementById("clear").onclick=clearSel;

let showPass=true;
document.getElementById("tpass").onclick=function(){
 showPass=!showPass;this.classList.toggle("on",showPass);
 COMPS.filter(c=>c.passive).forEach(c=>{
  const g=document.querySelector('[data-comp="'+c.id+'"]');
  if(g)g.style.display=showPass?"":"none";});
};
document.getElementById("tvf").onclick=function(){
 const vfc=COMPS.filter(c=>c.vf), vfn=Object.keys(NET).filter(n=>NET[n].vf);
 insp.innerHTML='<h2>Open items</h2><p class="emptyi">Unresolved before fabrication. Everything else is sourced from the vendor documentation or measured from the reference board.</p>'+
  '<h4 class="sec">Parts</h4><ul class="netlist">'+vfc.map(c=>
   '<li data-goto-comp="'+c.id+'"><span class="sw" style="background:var(--amber)"></span>'+esc(c.id)+' \u2014 '+esc(c.value||c.name)+'</li>').join("")+'</ul>'+
  (vfn.length?'<h4 class="sec">Nets</h4><ul class="netlist">'+vfn.map(n=>
   '<li data-goto="'+n+'"><span class="sw" style="background:var(--amber)"></span>'+esc(n)+'</li>').join("")+'</ul>':'')+
  '<div class="rulebox vfbox"><strong>The three</strong><span>1. SD0 boot fallback \u2014 TRM boot chapter.<br>2. PWR_SEQ2 driving a regulator EN at 1.8 V \u2014 check the threshold.<br>3. Thermal-pad stencil segmentation \u2014 ask your assembler.</span></div>';
 wireUp();
};
document.getElementById("tbom").onclick=function(){
 const grp={};
 COMPS.forEach(c=>{
  const v=c.value||c.mpn||c.name;if(!v)return;
  (grp[v]=grp[v]||[]).push(c.id);
 });
 const keys=Object.keys(grp).sort((a,b)=>grp[b].length-grp[a].length);
 insp.innerHTML='<h2>Bill of materials</h2><p class="emptyi">'+keys.length+' line items \u00b7 '+COMPS.length+' placed parts. DNP items are footprint-only.</p>'+
  keys.map(k=>'<div class="bomrow"><span class="v">'+esc(k)+'</span><span class="q">'+grp[k].length+'</span><span class="d">'+esc(grp[k].join(", "))+'</span></div>').join("");
};
document.getElementById("q").addEventListener("input",e=>{
 const q=e.target.value.trim().toUpperCase();
 if(!q)return renderEmpty();
 const nh=Object.keys(nets).filter(n=>nets[n].length>1&&n.toUpperCase().indexOf(q)>=0);
 const ch=COMPS.filter(c=>(c.id+" "+(c.value||"")+" "+(c.name||"")+" "+(c.mpn||"")+" "+(c.note||"")).toUpperCase().indexOf(q)>=0);
 insp.innerHTML='<h2>Matches</h2><p class="emptyi">'+nh.length+' net'+(nh.length===1?'':'s')+
  ' \u00b7 '+ch.length+' part'+(ch.length===1?'':'s')+'</p>'+
  (nh.length?'<h4 class="sec">Nets</h4><ul class="netlist">'+nh.map(n=>{const m=netMeta(n);
   return '<li data-goto="'+n+'"><span class="sw" style="background:'+LAYERS[m.L].color+'"></span>'+
    esc(n)+'<span class="ct">'+nets[n].length+'</span></li>';}).join("")+'</ul>':'')+
  (ch.length?'<h4 class="sec">Parts</h4><ul class="netlist">'+ch.map(c=>
   '<li data-goto-comp="'+c.id+'"><span class="sw" style="background:'+(c.vf?'var(--amber)':'var(--gold-dim)')+'"></span>'+
   esc(c.id)+' \u2014 '+esc(c.value||c.name)+'</li>').join("")+'</ul>':'');
 wireUp();
});
document.getElementById("s-comps").textContent=COMPS.length;
document.getElementById("s-nets").textContent=Object.keys(nets).filter(n=>nets[n].length>1).length;
document.getElementById("s-pins").textContent=Object.keys(pinIndex).length;
document.getElementById("s-vf").textContent=COMPS.filter(c=>c.vf).length+Object.keys(NET).filter(n=>NET[n].vf).length;

let vb={x:0,y:0,w:2600,h:1500};
const apply=()=>svg.setAttribute("viewBox",vb.x+" "+vb.y+" "+vb.w+" "+vb.h);
function zoomAt(f,cx,cy){
 const nw=Math.min(5200,Math.max(400,vb.w*f)),nh=nw*(1500/2600);
 vb.x=cx-(cx-vb.x)*(nw/vb.w);vb.y=cy-(cy-vb.y)*(nh/vb.h);vb.w=nw;vb.h=nh;apply();
}
const toSvg=(cx,cy)=>{const r=svg.getBoundingClientRect();
 return [vb.x+(cx-r.left)/r.width*vb.w,vb.y+(cy-r.top)/r.height*vb.h];};
svg.addEventListener("wheel",e=>{e.preventDefault();const c=toSvg(e.clientX,e.clientY);
 zoomAt(e.deltaY>0?1.13:.885,c[0],c[1]);},{passive:false});
let drag=null;
svg.addEventListener("pointerdown",e=>{drag={x:e.clientX,y:e.clientY,vx:vb.x,vy:vb.y};
 svg.classList.add("drag");svg.setPointerCapture(e.pointerId);hideTip();});
svg.addEventListener("pointermove",e=>{if(!drag)return;const r=svg.getBoundingClientRect();
 vb.x=drag.vx-(e.clientX-drag.x)/r.width*vb.w;vb.y=drag.vy-(e.clientY-drag.y)/r.height*vb.h;apply();});
["pointerup","pointercancel","pointerleave"].forEach(t=>
 svg.addEventListener(t,()=>{drag=null;svg.classList.remove("drag");}));
document.getElementById("zin").onclick=()=>zoomAt(.8,vb.x+vb.w/2,vb.y+vb.h/2);
document.getElementById("zout").onclick=()=>zoomAt(1.25,vb.x+vb.w/2,vb.y+vb.h/2);
document.getElementById("zfit").onclick=()=>{vb={x:0,y:0,w:2600,h:1500};apply();};
apply();renderEmpty();
</script>
