  R('R24','10k',620,620,'V','WL_REG_ON','GND','Holds the module disabled until software enables it.'),
  R('R25','10k',710,620,'V','WL_HOST_WAKE','GND','Host-wake pull-down.'),
  IC('U4','AP6212','WiFi/BT SDIO module',1330,480,
   {w:230,h:480,
    L:[['17','SDIO_CLK'],['16','SDIO_CMD'],['18','SDIO_D0'],['19','SDIO_D1'],['14','SDIO_D2'],
       ['15','SDIO_D3'],['12','WL_REG_ON'],['13','WL_HOST_WAKE']],
    R:[['2','WL_BT_ANT'],['24','LPO'],['34','BT_RST_N'],['21','VIN_LDO_OUT'],['23','VIN_LDO']],
    T:[['9','VBAT'],['22','VDDIO']],B:[['1/3/20','GND']]},
   {SDIO_CLK:'SD1_CLK_W',SDIO_CMD:'SD1_CMD',SDIO_D0:'SD1_D0',SDIO_D1:'SD1_D1',
    SDIO_D2:'SD1_D2',SDIO_D3:'SD1_D3',WL_REG_ON:'WL_REG_ON',WL_HOST_WAKE:'WL_HOST_WAKE',
    WL_BT_ANT:'WIFI_ANT',LPO:'LPO',BT_RST_N:'BT_RST',VIN_LDO_OUT:'WL_LDO_SW',VIN_LDO:'WL_LDO_IN',VBAT:'WIFI_VDD',VDDIO:'VDD3V3',GND:'GND'},
   'AP6212 — the only SDIO module on the vendor validated list with a mainline driver (brcmfmac). LPO wants a 32.768 kHz clock for BT low-power; check whether WiFi-only works without it.'),
  FBd('FB5','600R @100MHz',1150,140,'H','VDD3V3','WIFI_VDD','Isolates the module. WiFi TX bursts are the noisiest load on the board.'),
  C('C40','10 uF',1320,140,'V','WIFI_VDD','GND','Module bulk, sized for TX current bursts.'),
  C('C44','100 nF',1420,140,'V','WIFI_VDD','GND','Module bypass.'),
  IC('E1','u.FL','RF connector',1610,860,{w:110,h:110,L:[['1','RF']],B:[['2','GND']]},
   {RF:'WIFI_ANT',GND:'GND'},'Hirose U.FL-R-SMT-1(01) — the anti-solder-wicking variant.'),
  L('L4','4.7 uH',1610,300,'H','WL_LDO_SW','WL_LDO_IN','Internal buck inductor between pins 21 and 23. NOT a bypass — neither pin may touch a supply rail. Murata DFE252010P-4R7M.'),
  C('C58','10 uF',1610,430,'V','WL_LDO_IN','GND','Internal buck output cap on pin 23.')
 ]});

/* ============ 07 CLOCK & RESET ============ */
SHEETS.push({id:'07_Clock_Reset',title:'Clock · reset · straps',
 note:"The 25 MHz crystal is mandatory: 4-pin package with both case grounds bonded, and the 1 M across XIN/XOUT cannot be omitted. R15 is the strap you MUST populate — internal default boots ARM, not RISC-V.",
 comps:[
  IC('U1A','SG2002','RTC · clock · straps',400,480,
   {w:230,h:520,R:[['45','XTAL_XIN'],['46','XTAL_XOUT'],['39','PWR_RSTN'],['44','PWR_BUTTON1'],
     ['67','EPHY_RTX'],['35','PAD_ZQ'],['40','PWR_SEQ1'],['58','PWM0_BUCK'],['59','ADC1']]},
   {XTAL_XIN:'XTAL_XIN',XTAL_XOUT:'XTAL_XOUT',PWR_RSTN:'RESET_N',PWR_BUTTON1:'BOOT_BTN',
    EPHY_RTX:'CPU_SEL',PAD_ZQ:'ZQ_TP',PWR_SEQ1:'SEQ1_TP',PWM0_BUCK:'PWM0_BUCK',ADC1:'ADC1'},
   'EPHY_RTX sits on an Ethernet pin but selects the CPU core. Its pull-up goes to 1.8 V, not 3.3 V.',1),
  {ref:'Y1',kind:'XTAL',val:'25 MHz ±20 ppm',x:950,y:240,rot:'H',
   nets:{XI:'XTAL_XIN',XO:'XTAL_XOUT',G1:'GND',G2:'GND'},
   note:'TSX-3225 25.0000MF20X-W, 12 pF load. 4-pin package with both case grounds bonded — mandatory for ESD immunity.'},
  R('R43','1M',950,380,'H','XTAL_XIN','XTAL_XOUT','The design guide states this cannot be omitted.'),
  C('C55','18 pF NP0',810,380,'V','XTAL_XIN','GND','Load cap. C = 2 x (12 - 3 stray) = 18 pF. NP0/C0G only.'),
  C('C56','18 pF NP0',1090,380,'V','XTAL_XOUT','GND','Load cap, NP0/C0G.'),
  R('R15','4.7k FIT',950,560,'V','VDD1V8','CPU_SEL','POPULATE THIS. Internal default is pull-down = Cortex-A53. Fit to boot the C906 RISC-V core.'),
  R('R52','10k',1150,560,'V','RESET_N','VDD1V8','Reset pull-up.'),
  C('C57','100 nF',1250,620,'V','RESET_N','GND','Reset debounce.'),
  SWd('SW1','reset',1000,700,'RESET_N','GND','Momentary. PWR_RSTN, pin 39.'),
  SWd('SW2','boot',1000,810,'BOOT_BTN','GND','PWR_BUTTON1, pin 44 — already internally pulled up.'),
  TPd('TP1','ZQ',760,900,'ZQ_TP','No external resistor on the reference. First thing to probe when DDR init fails.'),
  TPd('TP2','SEQ1',870,900,'SEQ1_TP','Unused in an always-on topology.'),
  TPd('TP3','PWM0',1310,900,'PWM0_BUCK','Dynamic VDDC scaling. Footprints placed, network unpopulated.')
 ]});

/* ============ 08 IO ============ */
SHEETS.push({id:'08_IO',title:'Debug · headers · LEDs',
 note:"Most spare GPIO on this chip is 1.8 V — only six 3.3 V pins remain after SD0, SPI NOR and UART0. Silkscreen the domain on both sides of the board or someone will plug a 3.3 V sensor into the 1.8 V header.",
 comps:[
  IC('U1H','SG2002','spare IO',350,540,
   {w:250,h:800,L:[['26','JTAG_TMS'],['27','JTAG_TCK'],['28','IIC0_SCL'],['29','IIC0_SDA'],['30','AUX0'],['17','SPK_EN'],['3','AUD_AVREF'],['88','MIPI_TXP0']],
    R:[['72','MIPIRX4N'],['73','MIPIRX4P'],['74','MIPIRX3N'],['75','MIPIRX3P'],['76','MIPIRX2N'],['77','MIPIRX2P'],['78','MIPIRX1N'],['79','MIPIRX1P'],['80','MIPIRX0N'],['81','MIPIRX0P'],['83','MIPI_TXM2'],['84','MIPI_TXP2'],['85','MIPI_TXM1'],['86','MIPI_TXP1'],['87','MIPI_TXM0'],['2','AUD_AINL_MIC'],['4','AUD_AOUTR']]},
   {JTAG_TMS:'JTAG_TMS',JTAG_TCK:'JTAG_TCK',IIC0_SCL:'I2C0_SCL',IIC0_SDA:'I2C0_SDA',AUX0:'GPIO_AUX0',SPK_EN:'GPIO_A15',AUD_AVREF:'AUD_AVREF',MIPI_TXP0:'LPO',MIPIRX4N:'HDR18_0',MIPIRX4P:'HDR18_1',MIPIRX3N:'HDR18_2',MIPIRX3P:'HDR18_3',MIPIRX2N:'HDR18_4',MIPIRX2P:'HDR18_5',MIPIRX1N:'HDR18_6',MIPIRX1P:'HDR18_7',MIPIRX0N:'HDR18_8',MIPIRX0P:'HDR18_9',MIPI_TXM2:'HDR18_10',MIPI_TXP2:'HDR18_11',MIPI_TXM1:'HDR18_12',MIPI_TXP1:'HDR18_13',MIPI_TXM0:'HDR18_14',AUD_AINL_MIC:'HDR18_15',AUD_AOUTR:'HDR18_16'},
   'Every spare pin individually, no buses. Pins 72-87 are unused MIPI as XGPIOC (1.8 V); pins 2 and 4 are unused audio repurposed as GPIO. Pin 3 (AVREF) is an internal reference needing its own cap.',1),
  IC('J3','UART0','4-pin 115200',880,170,
   {w:150,h:180,R:[['1','GND'],['2','TX'],['3','RX'],['4','3V3']]},
   {GND:'GND',TX:'UART0_TX',RX:'UART0_RX','3V3':'VDD3V3'},
   'Your lifeline during bring-up. Square pad on pin 1, accessible edge.'),
  IC('J4','HDR 3V3','8-pin 2.54 mm',880,560,
   {w:150,h:250,L:[['1','SCL'],['2','SDA'],['3','TMS'],['4','TCK'],['5','AUX0'],['6','SPK'],['7','3V3'],['8','GND']]},
   {SCL:'I2C0_SCL',SDA:'I2C0_SDA',TMS:'JTAG_TMS',TCK:'JTAG_TCK',AUX0:'GPIO_AUX0',
    SPK:'GPIO_A15','3V3':'VDD3V3',GND:'GND'},'The last six 3.3 V pins on the device.'),
  IC('J5','HDR 1V8','20-pin 2.54 mm',1200,760,
   {w:170,h:660,L:[['1','IO0'],['2','IO1'],['3','IO2'],['4','IO3'],['5','IO4'],['6','IO5'],['7','IO6'],['8','IO7'],['9','IO8'],['10','IO9'],['11','IO10'],['12','IO11'],['13','IO12'],['14','IO13'],['15','IO14'],['16','IO15'],['17','IO16'],['18','1V8'],['19','GNDa'],['20','GNDb']]},
   {IO0:'HDR18_0',IO1:'HDR18_1',IO2:'HDR18_2',IO3:'HDR18_3',IO4:'HDR18_4',IO5:'HDR18_5',IO6:'HDR18_6',IO7:'HDR18_7',IO8:'HDR18_8',IO9:'HDR18_9',IO10:'HDR18_10',IO11:'HDR18_11',IO12:'HDR18_12',IO13:'HDR18_13',IO14:'HDR18_14',IO15:'HDR18_15',IO16:'HDR18_16','1V8':'VDD1V8',GNDa:'GND',GNDb:'GND'},
   '17 GPIO in the 1.8 V domain, one supply pin and TWO grounds. One return for 17 signals is not enough.'),
  C('C59','1 uF',800,1000,'V','AUD_AVREF','GND','Pin 3 is an internal audio reference — needs this cap whether or not audio is used.'),
  R('R53','2k',1560,300,'V','VDD3V3','LED_PWR_A','Power LED ballast.'),
  LEDd('LED1','green',1560,420,'V','LED_PWR_A','GND','Power indicator.'),
  R('R54','1k',1680,300,'V','GPIO_AUX0','LED_USR_A','User LED ballast on a spare 3.3 V pin.'),
  LEDd('LED2','green',1680,420,'V','LED_USR_A','GND','User-controlled indicator.')
 ]});
</script>
<script>
const NS='http://www.w3.org/2000/svg';
const sv=document.getElementById('sv'),side=document.getElementById('side'),
      nav=document.getElementById('nav'),tip=document.getElementById('tip');
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));

SHEETS.forEach(sh=>{
  sh.nets={};
  sh.comps.forEach(c=>{
    c.x=+c.x;c.y=+c.y;
    c.pins = c.kind==='IC' ? icPins(c.ic) : (()=>{
      const b=pinsFor(c.kind,c.rot),o={};
      Object.entries(b).forEach(([k,v])=>o[k]=[v[0],v[1],v[2],k]);return o;})();
    c.sheet=sh.id;
    Object.entries(c.nets||{}).forEach(([pn,net])=>{
      if(!net)return;(sh.nets[net]=sh.nets[net]||[]).push({ref:c.ref,pin:pn,comp:c});});
  });
});
const netSheets={};
SHEETS.forEach(sh=>Object.keys(sh.nets).forEach(n=>{(netSheets[n]=netSheets[n]||[]).push(sh.id);}));
let cur=0,sel=null,xs=false;
SHEETS.forEach((sh,i)=>{const b=document.createElement('button');
  b.innerHTML=sh.id.replace(/_/g,' ')+'<span class="n">'+sh.comps.length+'</span>';
  b.onclick=()=>{cur=i;sel=null;render();};nav.append(b);});
const el=(t,a)=>{const n=document.createElementNS(NS,t);for(const k in(a||{}))n.setAttribute(k,a[k]);return n;};

function render(){
  [...nav.children].forEach((b,i)=>b.classList.toggle('act',i===cur));
  const sh=SHEETS[cur];sv.innerHTML='';
  const root=el('g');sv.append(root);
  root.append(el('rect',{class:'bdr',x:20,y:20,width:1660,height:1110}));
  const tb=el('g',{class:'tb'});
  tb.append(el('rect',{class:'bdr',x:1200,y:1010,width:470,height:110}));
  tb.append(el('line',{class:'bdr',x1:1200,y1:1058,x2:1670,y2:1058}));
  const a=el('text',{class:'big',x:1214,y:1046});a.textContent='NANO-D1  '+sh.id.replace(/_/g,' ');tb.append(a);
  const b2=el('text',{x:1214,y:1078,'font-size':10});b2.textContent=sh.title;tb.append(b2);
  const c2=el('text',{x:1214,y:1098,'font-size':9,fill:'#8a8272'});
  c2.textContent='SG2002 SBC · 65 x 30 mm · 4 layer · rev2';tb.append(c2);
  const d2=el('text',{x:1656,y:1098,'font-size':9,fill:'#8a8272','text-anchor':'end'});
  d2.textContent='Sheet '+(cur+1)+' of '+SHEETS.length;tb.append(d2);
  root.append(tb);
  const gW=el('g'),gC=el('g'),gL=el('g');root.append(gW,gC,gL);

  sh.comps.forEach(c=>{
    const g=el('g',{class:'cbox','data-ref':c.ref,transform:`translate(${c.x},${c.y})`});
    g.innerHTML=c.kind==='IC'?drawIC(c):drawSym(c);
    if(c.kind!=='IC'){
      const t1=el('text',{class:'ref',x:c.rot==='V'?16:-18,y:c.rot==='V'?-4:-14});t1.textContent=c.ref;g.append(t1);
      const t2=el('text',{class:'val',x:c.rot==='V'?16:-18,y:c.rot==='V'?8:-3});t2.textContent=c.val;g.append(t2);
    }else{
      const t1=el('text',{class:'ref',x:-c.ic.w/2,y:-c.ic.h/2-16});t1.textContent=c.ref;g.append(t1);
      const t2=el('text',{class:'val',x:-c.ic.w/2,y:-c.ic.h/2-5});t2.textContent=c.val;g.append(t2);
    }
    gC.append(g);
  });

  sh.comps.forEach(c=>{
    Object.entries(c.nets||{}).forEach(([pn,net])=>{
      const p=c.pins[pn];if(!p||!net)return;
      const [px,py,dir]=p,ax=c.x+px,ay=c.y+py;
      const dv={L:[-1,0],R:[1,0],U:[0,-1],D:[0,1]}[dir];
      const ex=ax+dv[0]*S,ey=ay+dv[1]*S;
      gW.append(el('path',{class:'wire',d:`M${ax} ${ay} L${ex} ${ey}`,'data-net':net}));
      if(GNDNETS.has(net)){
        const g=el('g',{'data-net':net,style:'cursor:pointer'});
        g.append(el('path',{class:'pp','data-net':net,
          d:`M${ex} ${ey} l0 8 M${ex-9} ${ey+8} l18 0 M${ex-5.5} ${ey+12} l11 0 M${ex-2.5} ${ey+16} l5 0`}));
        if(net!=='GND'){const t=el('text',{class:'ppt',x:ex,y:ey+30,'text-anchor':'middle','data-net':net});
          t.textContent=net;g.append(t);}
        gL.append(g);
      } else if(RAILS.has(net)){
        const g=el('g',{'data-net':net,style:'cursor:pointer'}),up=ey-10;
        g.append(el('path',{class:'pp','data-net':net,d:`M${ex} ${ey} L${ex} ${up} M${ex-11} ${up} l22 0`}));
        const t=el('text',{class:'ppt',x:ex,y:up-5,'text-anchor':'middle','data-net':net});
        t.textContent=net;g.append(t);gL.append(g);
      } else {
        const cross=(netSheets[net]||[]).length>1;
        const g=el('g',{'data-net':net,style:'cursor:pointer'});
        const tw=Math.max(30,net.length*5.4+16);
        if(cross)g.append(el('path',{class:'offp','data-net':net,
          d:dir==='L'?`M${ex} ${ey-8} l${-tw+8} 0 l-8 8 l8 8 l${tw-8} 0 z`
                     :`M${ex} ${ey-8} l${tw-8} 0 l8 8 l-8 8 l${-tw+8} 0 z`}));
        const t=el('text',{class:cross?'offt':'nl',x:dir==='L'?ex-6:ex+6,y:ey+3,
          'text-anchor':dir==='L'?'end':'start','data-net':net});
        t.textContent=net;g.append(t);gL.append(g);
      }
    });
  });
  applySel();renderSide();vb={x:0,y:0,w:1700,h:1150};apply();
}
function applySel(){
  sv.classList.toggle('xs',xs);
  document.querySelectorAll('.wire,.nl,.offp,.offt,.pp,.ppt,.cbox').forEach(e=>e.classList.remove('hot','dim'));
  if(!sel)return;
  const refs=new Set((SHEETS[cur].nets[sel]||[]).map(n=>n.ref));
  document.querySelectorAll('[data-net]').forEach(e=>
    e.classList.add(e.getAttribute('data-net')===sel?'hot':'dim'));
  document.querySelectorAll('.cbox').forEach(g=>
    g.classList.add(refs.has(g.getAttribute('data-ref'))?'hot':'dim'));
}
function renderSide(){
  const sh=SHEETS[cur];
  if(!sel){
    const nets=Object.keys(sh.nets).sort();
    const cross=nets.filter(n=>(netSheets[n]||[]).length>1);
    side.innerHTML='<h2>'+esc(sh.id.replace(/_/g,' '))+'</h2><p><b>'+esc(sh.title)+'</b><br><br>'+esc(sh.note)+'</p>'+
      '<div class="note">Purple flags are nets shared with other sheets. Red text is local. Bars are rails, the ladder is ground.</div>'+
      '<h4 class="sec">Nets here — '+nets.length+'</h4><ul class="l">'+
      nets.map(n=>{const x=(netSheets[n]||[]).length>1;
        return '<li data-net="'+n+'"><span class="r" style="color:'+(x?'#b98fd6':'#d4571c')+'">'+(x?'↗':'·')+'</span>'+
        esc(n)+'<span class="s">'+sh.nets[n].length+'</span></li>';}).join('')+'</ul>'+
      '<h4 class="sec">Cross-sheet — '+cross.length+'</h4><ul class="l">'+
      cross.map(n=>'<li data-net="'+n+'">'+esc(n)+'<span class="s">'+netSheets[n].length+'</span></li>').join('')+'</ul>';
  }else{
    const nodes=sh.nets[sel]||[],where=netSheets[sel]||[],info=NETINFO[sel];
    side.innerHTML='<div class="nethead"><h3>'+esc(sel)+'</h3>'+
      (where.length>1?'<span class="chip x">'+where.length+' sheets</span>':'<span class="chip">local</span>')+'</div>'+
      '<dl class="m"><div><dt>Nodes</dt><dd>'+nodes.length+' here</dd></div>'+
      '<div><dt>Sheets</dt><dd>'+esc(where.map(s=>s.replace(/_/g,' ')).join(', '))+'</dd></div></dl>'+
      (info?'<div class="note warn">'+esc(info)+'</div>':'')+
      '<h4 class="sec">Connections</h4><ul class="l">'+
      nodes.map(n=>'<li><span class="r">'+esc(n.ref)+'</span>'+esc(n.pin)+
        '<span class="s">'+esc(n.comp.val||'')+'</span></li>').join('')+'</ul>'+
      '<h4 class="sec">Jump</h4><ul class="l">'+
      where.map(s=>'<li data-sheet="'+s+'">'+esc(s.replace(/_/g,' '))+'</li>').join('')+'</ul>';
  }
  side.querySelectorAll('[data-net]').forEach(e=>e.onclick=()=>{sel=e.getAttribute('data-net');applySel();renderSide();});
  side.querySelectorAll('[data-sheet]').forEach(e=>e.onclick=()=>{
    const i=SHEETS.findIndex(s=>s.id===e.getAttribute('data-sheet'));
    if(i>=0){const k=sel;cur=i;render();sel=k;applySel();renderSide();}});
}
sv.addEventListener('click',e=>{
  const n=e.target.closest('[data-net]');
  if(n){sel=n.getAttribute('data-net');applySel();renderSide();return;}
  const c=e.target.closest('.cbox');
  if(c){const comp=SHEETS[cur].comps.find(x=>x.ref===c.getAttribute('data-ref'));
    if(comp){side.innerHTML='<div class="nethead"><h3>'+esc(comp.ref)+'</h3><span class="chip">'+esc(comp.kind)+'</span></div>'+
      '<dl class="m"><div><dt>Value</dt><dd>'+esc(comp.val||comp.name||'')+'</dd></div>'+
      '<div><dt>Sheet</dt><dd>'+esc(comp.sheet.replace(/_/g,' '))+'</dd></div></dl>'+
      (comp.note?'<div class="note">'+esc(comp.note)+'</div>':'')+
      '<h4 class="sec">Pins</h4><ul class="l">'+
      Object.entries(comp.nets||{}).map(([p,nt])=>'<li data-net="'+nt+'"><span class="r">'+esc(p)+'</span>'+esc(nt)+'</li>').join('')+'</ul>';
      side.querySelectorAll('[data-net]').forEach(x=>x.onclick=()=>{sel=x.getAttribute('data-net');applySel();renderSide();});
      sel=null;applySel();document.querySelectorAll('.cbox').forEach(g=>g.classList.toggle('hot',g===c));}
    return;}
  sel=null;applySel();renderSide();
});
sv.addEventListener('pointermove',e=>{
  if(drag){tip.classList.remove('on');return;}
  const n=e.target.closest('[data-net]');
  if(n){const net=n.getAttribute('data-net'),w=netSheets[net]||[];
    return showTip('<div class="tr">'+esc(net)+'</div><div class="tv">'+
      (w.length>1?w.length+' sheets: '+esc(w.map(s=>s.replace(/_/g,' ')).join(', ')):'local to this sheet')+'</div>'+
      (NETINFO[net]?'<div class="tn">'+esc(NETINFO[net])+'</div>':''),e);}
  const c=e.target.closest('.cbox');
  if(c){const comp=SHEETS[cur].comps.find(x=>x.ref===c.getAttribute('data-ref'));
    if(comp)return showTip('<div class="tr">'+esc(comp.ref)+'</div><div class="tv">'+esc(comp.val||comp.name||'')+
      '</div>'+(comp.note?'<div class="tn">'+esc(comp.note)+'</div>':''),e);}
  tip.classList.remove('on');
});
function showTip(h,e){tip.innerHTML=h;tip.classList.add('on');
  const r=sv.getBoundingClientRect();let x=e.clientX-r.left+14,y=e.clientY-r.top+14;
  if(x+305>r.width)x=Math.max(4,e.clientX-r.left-309);
  if(y+tip.offsetHeight>r.height)y=Math.max(4,r.height-tip.offsetHeight-6);
  tip.style.left=x+'px';tip.style.top=y+'px';}
sv.addEventListener('pointerleave',()=>tip.classList.remove('on'));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){sel=null;applySel();renderSide();}});
document.getElementById('bc').onclick=()=>{sel=null;applySel();renderSide();};
document.getElementById('bx').onclick=function(){xs=!xs;this.classList.toggle('on',xs);applySel();};
document.getElementById('q').addEventListener('input',e=>{
  const q=e.target.value.trim().toUpperCase();
  if(!q)return renderSide();
  const hits=[],seen=new Set();
  SHEETS.forEach(sh=>{
    Object.keys(sh.nets).forEach(n=>{if(n.toUpperCase().includes(q)&&!seen.has('n'+n+sh.id)){seen.add('n'+n+sh.id);hits.push({t:'net',n,s:sh.id});}});
    sh.comps.forEach(c=>{if((c.ref+' '+(c.val||'')+' '+(c.name||'')).toUpperCase().includes(q))hits.push({t:'p',n:c.ref,v:c.val,s:sh.id});});
  });
  side.innerHTML='<h2>Matches</h2><p>'+hits.length+'</p><ul class="l">'+
    hits.slice(0,70).map(h=>'<li '+(h.t==='net'?'data-net="'+h.n+'" ':'')+'data-sheet="'+h.s+'">'+
      '<span class="r">'+(h.t==='net'?'~':esc(h.n))+'</span>'+esc(h.t==='net'?h.n:(h.v||''))+
      '<span class="s">'+esc(h.s.replace(/_/g,' '))+'</span></li>').join('')+'</ul>';
  side.querySelectorAll('[data-sheet]').forEach(e2=>e2.onclick=()=>{
    const i=SHEETS.findIndex(s=>s.id===e2.getAttribute('data-sheet')),nt=e2.getAttribute('data-net');
    if(i>=0){cur=i;render();if(nt){sel=nt;applySel();renderSide();}}});
});
let vb={x:0,y:0,w:1700,h:1150};
const apply=()=>sv.setAttribute('viewBox',vb.x+' '+vb.y+' '+vb.w+' '+vb.h);
function zoomAt(f,cx,cy){const nw=Math.min(4000,Math.max(300,vb.w*f)),nh=nw*(1150/1700);
  vb.x=cx-(cx-vb.x)*(nw/vb.w);vb.y=cy-(cy-vb.y)*(nh/vb.h);vb.w=nw;vb.h=nh;apply();}
const toSvg=(cx,cy)=>{const r=sv.getBoundingClientRect();
  return [vb.x+(cx-r.left)/r.width*vb.w,vb.y+(cy-r.top)/r.height*vb.h];};
sv.addEventListener('wheel',e=>{e.preventDefault();const c=toSvg(e.clientX,e.clientY);
  zoomAt(e.deltaY>0?1.12:.89,c[0],c[1]);},{passive:false});
let drag=null;
sv.addEventListener('pointerdown',e=>{drag={x:e.clientX,y:e.clientY,vx:vb.x,vy:vb.y};
  sv.classList.add('drag');sv.setPointerCapture(e.pointerId);tip.classList.remove('on');});
sv.addEventListener('pointermove',e=>{if(!drag)return;const r=sv.getBoundingClientRect();
  vb.x=drag.vx-(e.clientX-drag.x)/r.width*vb.w;vb.y=drag.vy-(e.clientY-drag.y)/r.height*vb.h;apply();});
['pointerup','pointercancel','pointerleave'].forEach(t=>
  sv.addEventListener(t,()=>{drag=null;sv.classList.remove('drag');}));
document.getElementById('zi').onclick=()=>zoomAt(.8,vb.x+vb.w/2,vb.y+vb.h/2);
document.getElementById('zo').onclick=()=>zoomAt(1.25,vb.x+vb.w/2,vb.y+vb.h/2);
document.getElementById('zf').onclick=()=>{vb={x:0,y:0,w:1700,h:1150};apply();};
render();
</script>
