<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nano-D1 — Schematic Sheets</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--pap:#f4f1e8;--ink0:#16140f;--ink1:#3a352b;--mute:#8a8272;--rule:#c9c2af;
 --wire:#1b3a6b;--lbl:#8a2f1f;--pwr:#1f6b4a;--off:#7a3fa8;--hot:#d4571c;
 --disp:"Barlow Condensed",Oswald,"Arial Narrow",sans-serif;--mono:"JetBrains Mono",ui-monospace,Menlo,monospace}
*{box-sizing:border-box}html,body{margin:0;height:100%}
body{background:#211e18;color:var(--ink0);font-family:var(--mono);font-size:13px;
 overflow:hidden;display:grid;grid-template-rows:auto auto 1fr;height:100vh}
header{display:flex;background:linear-gradient(180deg,#2b2820,#201d17);border-bottom:1px solid #3d382d;color:#ece5d4}
.brand{padding:8px 15px;border-right:1px solid #3d382d}
.brand h1{font-family:var(--disp);font-size:20px;font-weight:700;letter-spacing:.06em;margin:0;text-transform:uppercase;color:#d4a843}
.brand span{font-size:9px;color:#8d8574;letter-spacing:.14em;text-transform:uppercase}
.htools{flex:1;display:flex;align-items:center;gap:8px;padding:0 14px;min-width:0}
.htools input{flex:1;min-width:0;max-width:300px;background:#141209;border:1px solid #3d382d;color:#ece5d4;
 font-family:var(--mono);font-size:12px;padding:6px 9px;border-radius:3px;outline:none}
.htools button{background:none;border:1px solid #3d382d;color:#8d8574;font-family:var(--mono);
 font-size:10.5px;padding:6px 9px;border-radius:3px;cursor:pointer;white-space:nowrap}
.htools button:hover{border-color:#8a6f2e;color:#d4a843}
.htools button.on{border-color:#d4a843;color:#d4a843;background:#332b18}
nav{display:flex;background:#1a1813;border-bottom:1px solid #3d382d;overflow-x:auto}
nav button{background:none;border:none;border-right:1px solid #2c2820;color:#8d8574;
 font-family:var(--disp);font-size:14px;letter-spacing:.09em;text-transform:uppercase;
 padding:9px 15px;cursor:pointer;white-space:nowrap}
nav button:hover{color:#ece5d4;background:#242019}
nav button.act{color:#16140f;background:var(--pap);font-weight:600}
nav button .n{font-family:var(--mono);font-size:9px;opacity:.55;margin-left:5px}
.shell{display:grid;grid-template-columns:1fr 320px;min-height:0}
@media(max-width:1100px){.shell{grid-template-columns:1fr}.side{display:none}}
.paper{position:relative;overflow:hidden;background:var(--pap)}
svg{width:100%;height:100%;display:block;cursor:grab;touch-action:none}
svg.drag{cursor:grabbing}
.hint{position:absolute;left:12px;bottom:10px;font-size:9.5px;color:var(--mute);
 background:rgba(244,241,232,.94);border:1px solid var(--rule);padding:4px 8px;border-radius:2px;pointer-events:none}
.zoomer{position:absolute;right:10px;bottom:10px;display:flex;gap:4px}
.zoomer button{width:26px;height:26px;background:rgba(244,241,232,.96);border:1px solid var(--rule);
 color:var(--ink1);border-radius:2px;cursor:pointer;font-family:var(--mono);font-size:12px}
.zoomer button:hover{border-color:var(--hot);color:var(--hot)}
#tip{position:absolute;pointer-events:none;z-index:20;width:295px;background:#16140f;color:#ece5d4;
 border:1px solid #d4a843;border-radius:3px;padding:8px 10px;font-size:10.5px;line-height:1.55;
 box-shadow:0 6px 22px rgba(0,0,0,.5);opacity:0;transition:opacity .12s}
#tip.on{opacity:1}
#tip .tr{font-family:var(--disp);font-size:15px;font-weight:600;color:#d4a843;line-height:1.1}
#tip .tv{font-size:11.5px;margin-top:1px}
#tip .tn{margin-top:6px;padding-top:5px;border-top:1px solid #3d382d;color:#cfc7b3;font-size:10px}
.bdr{fill:none;stroke:var(--ink1);stroke-width:1.4}
.tb text{font-family:var(--mono);fill:var(--ink1)}
.tb .big{font-family:var(--disp);font-size:19px;font-weight:700;letter-spacing:.05em}
.sym{fill:none;stroke:var(--ink0);stroke-width:1.5;stroke-linecap:round}
.symf{fill:var(--ink0);stroke:none}
.icbox{fill:#fdfbf4;stroke:var(--ink0);stroke-width:1.5}
.socbox{fill:#fbf7ea;stroke:var(--ink0);stroke-width:2}
.pinl{stroke:var(--ink0);stroke-width:1.2}
.ref{font-family:var(--mono);font-size:9.5px;fill:var(--ink0);font-weight:700}
.val{font-family:var(--mono);font-size:9px;fill:var(--ink1)}
.pn{font-family:var(--mono);font-size:7px;fill:var(--mute)}
.pname{font-family:var(--mono);font-size:8px;fill:var(--ink1)}
.icname{font-family:var(--disp);font-size:13px;font-weight:600;fill:var(--ink0);letter-spacing:.04em}
.wire{stroke:var(--wire);stroke-width:1.6;fill:none;stroke-linecap:round;cursor:pointer}
.wire:hover{stroke:var(--hot);stroke-width:2.4}
.nl{font-family:var(--mono);font-size:8.5px;fill:var(--lbl);cursor:pointer;font-weight:700}
.pp{stroke:var(--pwr);stroke-width:1.6;fill:none}
.ppt{font-family:var(--mono);font-size:8px;fill:var(--pwr);font-weight:700}
.offp{fill:#f6eefc;stroke:var(--off);stroke-width:1.2;cursor:pointer}
.offt{font-family:var(--mono);font-size:8px;fill:var(--off);font-weight:700;pointer-events:none}
.wire.hot{stroke:var(--hot);stroke-width:2.6}
.nl.hot{fill:var(--hot)}.offp.hot{stroke:var(--hot);fill:#fdeee4}.offt.hot{fill:var(--hot)}
.pp.hot{stroke:var(--hot)}.ppt.hot{fill:var(--hot)}
.dim{opacity:.16}
.xs .offp{stroke:var(--hot);stroke-width:2}.xs .offt{fill:var(--hot)}
.cbox{cursor:pointer}
.cbox.hot .icbox,.cbox.hot .socbox{stroke:var(--hot);stroke-width:2.4}
.cbox.hot .sym{stroke:var(--hot)}.cbox.hot .ref{fill:var(--hot)}
.side{background:#201d17;border-left:1px solid #3d382d;overflow-y:auto;padding:12px 12px 40px;color:#ece5d4}
.side h2{font-family:var(--disp);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#8d8574;margin:0 0 6px;font-weight:600}
.side p{font-size:10.5px;color:#8d8574;line-height:1.7;margin:0 0 12px}
.side p b{color:#cfc7b3;font-weight:500}
.nethead{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap}
.nethead h3{font-family:var(--disp);font-size:23px;font-weight:700;margin:0;color:#d4a843;line-height:1;word-break:break-all}
.chip{font-size:8.5px;letter-spacing:.09em;text-transform:uppercase;padding:2px 6px;border-radius:2px;background:#3d382d;color:#cfc7b3}
.chip.x{background:var(--off);color:#fff}
dl.m{margin:10px 0 0;border-top:1px solid #3d382d}
dl.m div{display:flex;gap:8px;padding:5px 0;border-bottom:1px solid #2c2820;font-size:10.5px}
dl.m dt{color:#6d6553;min-width:60px;font-size:9.5px;text-transform:uppercase;letter-spacing:.05em}
dl.m dd{margin:0;color:#ece5d4;line-height:1.5}
.note{margin-top:10px;padding:8px;border:1px solid #3d382d;border-left:2px solid #d4a843;
 font-size:10px;line-height:1.6;background:#1a1813;border-radius:2px;color:#cfc7b3}
.note.warn{border-left-color:var(--hot)}
h4.sec{font-family:var(--disp);font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:#8d8574;margin:14px 0 4px;font-weight:600}
ul.l{list-style:none;margin:0;padding:0}
ul.l li{display:flex;gap:6px;padding:4px;font-size:10px;border-bottom:1px solid #2c2820;cursor:pointer;align-items:baseline}
ul.l li:hover{background:#282318}
ul.l li .r{color:#d4a843;min-width:32px;font-weight:600}
ul.l li .s{margin-left:auto;color:#6d6553;font-size:9px}
:focus-visible{outline:2px solid #d4a843;outline-offset:2px}
</style>

<header>
  <div class="brand"><h1>Nano-D1</h1><span>Schematic sheets</span></div>
  <div class="htools">
    <input id="q" placeholder="Search nets and parts">
    <button id="bx">Cross-sheet</button>
    <button id="bc">Clear</button>
  </div>
</header>
<nav id="nav"></nav>
<div class="shell">
  <div class="paper">
    <svg id="sv" viewBox="0 0 1700 1150" preserveAspectRatio="xMidYMid meet"></svg>
    <div id="tip"></div>
    <div class="hint">Click a wire, label or part to trace · drag to pan · scroll to zoom · Esc clears</div>
    <div class="zoomer"><button id="zi">+</button><button id="zo">−</button><button id="zf">⤢</button></div>
  </div>
  <aside class="side" id="side"></aside>
</div>

<script>
const S=18;
function pinsFor(kind,rot){
  if(kind==='R'||kind==='FB')return rot==='H'?{A:[-30,0,'L'],B:[30,0,'R']}:{A:[0,-30,'U'],B:[0,30,'D']};
  if(kind==='C')return rot==='H'?{A:[-26,0,'L'],B:[26,0,'R']}:{A:[0,-26,'U'],B:[0,26,'D']};
  if(kind==='L')return rot==='H'?{A:[-32,0,'L'],B:[32,0,'R']}:{A:[0,-32,'U'],B:[0,32,'D']};
  if(kind==='D'||kind==='LED')return rot==='H'?{A:[-26,0,'L'],K:[26,0,'R']}:{A:[0,-26,'U'],K:[0,26,'D']};
  if(kind==='SW')return {A:[-30,0,'L'],B:[30,0,'R']};
  if(kind==='TP')return {A:[0,20,'D']};
  if(kind==='XTAL')return {XI:[-32,0,'L'],XO:[32,0,'R'],G1:[-14,26,'D'],G2:[14,26,'D']};
  return {};
}
function drawSym(c){
  const k=c.kind,g=[],P=d=>g.push(d);
  if(k==='R'||k==='FB'){const dash=k==='FB'?' stroke-dasharray="3 2"':'';
    if(c.rot==='H'){P(`<rect class="sym" x="-16" y="-7" width="32" height="14"${dash}/>`);
      P(`<line class="pinl" x1="-30" y1="0" x2="-16" y2="0"/><line class="pinl" x1="16" y1="0" x2="30" y2="0"/>`);}
    else{P(`<rect class="sym" x="-7" y="-16" width="14" height="32"${dash}/>`);
      P(`<line class="pinl" x1="0" y1="-30" x2="0" y2="-16"/><line class="pinl" x1="0" y1="16" x2="0" y2="30"/>`);}
  } else if(k==='C'){
    if(c.rot==='H'){P(`<line class="sym" x1="-4" y1="-11" x2="-4" y2="11"/><line class="sym" x1="4" y1="-11" x2="4" y2="11"/>`);
      P(`<line class="pinl" x1="-26" y1="0" x2="-4" y2="0"/><line class="pinl" x1="4" y1="0" x2="26" y2="0"/>`);}
    else{P(`<line class="sym" x1="-11" y1="-4" x2="11" y2="-4"/><line class="sym" x1="-11" y1="4" x2="11" y2="4"/>`);
      P(`<line class="pinl" x1="0" y1="-26" x2="0" y2="-4"/><line class="pinl" x1="0" y1="4" x2="0" y2="26"/>`);}
  } else if(k==='L'){
    if(c.rot==='H'){P(`<path class="sym" d="M-18 0 q4.5 -10 9 0 q4.5 -10 9 0 q4.5 -10 9 0 q4.5 -10 9 0"/>`);
      P(`<line class="pinl" x1="-32" y1="0" x2="-18" y2="0"/><line class="pinl" x1="18" y1="0" x2="32" y2="0"/>`);}
    else{P(`<path class="sym" d="M0 -18 q10 4.5 0 9 q10 4.5 0 9 q10 4.5 0 9 q10 4.5 0 9"/>`);
      P(`<line class="pinl" x1="0" y1="-32" x2="0" y2="-18"/><line class="pinl" x1="0" y1="18" x2="0" y2="32"/>`);}
  } else if(k==='D'||k==='LED'){
    if(c.rot==='H'){P(`<path class="symf" d="M-9 -9 L7 0 L-9 9 Z"/><line class="sym" x1="7" y1="-9" x2="7" y2="9"/>`);
      P(`<line class="pinl" x1="-26" y1="0" x2="-9" y2="0"/><line class="pinl" x1="7" y1="0" x2="26" y2="0"/>`);}
    else{P(`<path class="symf" d="M-9 -8 L9 -8 L0 8 Z"/><line class="sym" x1="-9" y1="8" x2="9" y2="8"/>`);
      P(`<line class="pinl" x1="0" y1="-26" x2="0" y2="-8"/><line class="pinl" x1="0" y1="8" x2="0" y2="26"/>`);}
    if(k==='LED'){P(`<line class="sym" x1="10" y1="-12" x2="17" y2="-19"/><line class="sym" x1="15" y1="-9" x2="22" y2="-16"/>`);}
  } else if(k==='SW'){
    P(`<line class="pinl" x1="-30" y1="0" x2="-11" y2="0"/><line class="pinl" x1="11" y1="0" x2="30" y2="0"/>`);
    P(`<circle class="sym" cx="-11" cy="0" r="2.4"/><circle class="sym" cx="11" cy="0" r="2.4"/>`);
    P(`<line class="sym" x1="-11" y1="0" x2="10" y2="-12"/><line class="sym" x1="-4" y1="-13" x2="4" y2="-13"/>`);
  } else if(k==='TP'){
    P(`<circle class="sym" cx="0" cy="0" r="6"/><line class="pinl" x1="0" y1="6" x2="0" y2="20"/>`);
  } else if(k==='XTAL'){
    P(`<rect class="sym" x="-7" y="-11" width="14" height="22"/>`);
    P(`<line class="sym" x1="-13" y1="-12" x2="-13" y2="12"/><line class="sym" x1="13" y1="-12" x2="13" y2="12"/>`);
    P(`<line class="pinl" x1="-32" y1="0" x2="-13" y2="0"/><line class="pinl" x1="13" y1="0" x2="32" y2="0"/>`);
    P(`<line class="pinl" x1="-14" y1="11" x2="-14" y2="26"/><line class="pinl" x1="14" y1="11" x2="14" y2="26"/>`);
  }
  return g.join('');
}
function icPins(d){
  const p={},put=(arr,side)=>{
    const n=arr.length;if(!n)return;
    const horiz=(side==='L'||side==='R'),span=horiz?d.h:d.w,step=span/(n+1);
    arr.forEach((e,i)=>{const o=-span/2+step*(i+1);
      if(side==='L')p[e[1]]=[-d.w/2-S,o,'L',e[0]];
      else if(side==='R')p[e[1]]=[d.w/2+S,o,'R',e[0]];
      else if(side==='T')p[e[1]]=[o,-d.h/2-S,'U',e[0]];
      else p[e[1]]=[o,d.h/2+S,'D',e[0]];});
  };
  put(d.L||[],'L');put(d.R||[],'R');put(d.T||[],'T');put(d.B||[],'B');return p;
}
function drawIC(c){
  const d=c.ic,w=d.w,h=d.h,g=[],cls=c.soc?'socbox':'icbox';
  g.push(`<rect class="${cls}" x="${-w/2}" y="${-h/2}" width="${w}" height="${h}" rx="2"/>`);
  g.push(`<text class="icname" x="0" y="${-h/2+16}" text-anchor="middle">${c.name||c.ref}</text>`);
  Object.entries(c.pins).forEach(([nm,p])=>{
    const [x,y,dir,num]=p;
    const ex=dir==='L'?-w/2:dir==='R'?w/2:x, ey=dir==='U'?-h/2:dir==='D'?h/2:y;
    g.push(`<line class="pinl" x1="${x}" y1="${y}" x2="${ex}" y2="${ey}"/>`);
    const anc=dir==='L'?'start':dir==='R'?'end':'middle';
    const tx=dir==='L'?-w/2+5:dir==='R'?w/2-5:x, ty=dir==='U'?-h/2+11:dir==='D'?h/2-5:y+3;
    g.push(`<text class="pname" x="${tx}" y="${ty}" text-anchor="${anc}">${nm}</text>`);
    const nx=dir==='L'?-w/2-6:dir==='R'?w/2+6:x+5, ny=dir==='U'?-h/2-6:dir==='D'?h/2+10:y-4;
    g.push(`<text class="pn" x="${nx}" y="${ny}" text-anchor="${dir==='L'?'end':dir==='R'?'start':'middle'}">${num}</text>`);
  });
  return g.join('');
}
</script>
<script>
/* ============ NET NOTES ============ */
const NETINFO={
 GND:"Single ground net. Pin 1 is audio-local, everything else returns through the E-pad (89) — 39 vias on the reference board.",
 CHGND:"Kept SEPARATE deliberately: isolated chassis island under the RJ45, bridged to GND only by 1M in parallel with 1nF/2kV.",
 VBUS_5V:"USB-C sink only. CC1 and CC2 each need their own 5.1k.",
 VDD3V3:"One 3.3 V net. The reference merges VDDIO_SD0, VDDIO_SD1 and VDD33A_ETH into a single rail (their SPI_VCC), so this board does too.",
 VDD1V8:"One 1.8 V net feeding VDD18A_AUD, VDD18A_MIPI and VDDIO_RTC. Each pin still gets its own 100 nF.",
 VDD18A_USB:"Kept SEPARATE: ferrite-isolated from VDD1V8. This is the USB PHY, PLL and Ethernet analog supply — the PLL clocks the whole chip.",
 VDD1V35:"DDR3L VDDQ. External supply, not internal to the SiP. 3 vias in the E-pad mask ring at y=-3.600.",
 VDDC:"0.95 V for SG2002, NOT 0.9 V. Size for 1.5 A. R46=11k8 sets it.",
 VDDC_RTC:"Kept SEPARATE: internal LDO output on pin 37. Capacitors only — never drive this.",
 WIFI_VDD:"Kept SEPARATE: ferrite-isolated. WiFi TX bursts are the noisiest load on the board.",
 FB_VDDC:"0.6 x (11.8/20 + 1) = 0.954 V. Reference fits 10k here for 0.90 V — do not copy it.",
 FB_3V3:"0.6 x (100/22.6 + 1) = 3.26 V. From the reference design.",
 FB_1V35:"0.6 x (15/12 + 1) = 1.35 V. From the reference design.",
 PWR_SEQ2:"Gates the 3.3 V regulator EN — the entire sequencing scheme. ETA3414 EN threshold 1.2 V max vs 1.8 V drive: 0.42 V margin, verified.",
 UART0_TX:"BOOT STRAP. The 4.7k pull-up is mandatory — a pull-down puts the chip in ROM fail mode.",
 CPU_SEL:"BOOT STRAP, pin 67. Internal default is pull-DOWN = Cortex-A53. You MUST fit R15 to boot RISC-V.",
 SPI_WP:"EMMC_DAT3, pin 23. Pull DOWN for SPI NOR boot; leave open for SD-card boot.",
 SPI_MOSI:"EMMC_DAT0, pin 22. Boot device is latched from pins 22+23 together.",
 VBAT_DET:"30k/10k from 5 V gives 1.25 V. The chip will not start with this floating.",
 XTAL_XIN:"0.25 mm trace with per-trace ground shield. The 1M across XIN/XOUT cannot be omitted.",
 EPHY_RXN:"Package pin is PAD_ETH_TXP. TX/RX and P/N are both crossed by the vendor — do not 'fix' it.",
 EPHY_RXP:"Package pin is PAD_ETH_TXM. Vendor naming is crossed.",
 EPHY_TXN:"Package pin is PAD_ETH_RXP. Vendor naming is crossed.",
 EPHY_TXP:"Package pin is PAD_ETH_RXM. Vendor naming is crossed.",
 WIFI_ANT:"50 ohm, 0.762 mm wide, referenced to L4. All planes cut away beneath.",
 USB_DP:"90 ohm pair, SoC side of the series resistor. Intra-pair skew under 10 mil.",
 SD0_CLK:"CL under 30 pF is the binding constraint, not frequency. Short, one via, no stubs.",
 SPI_CLK:"The only single-ended net needing individual ground shielding.",
 LPO:"32.768 kHz low-power clock for the AP6212's Bluetooth modes. Driven from SoC pin 88 — a 1.8 V pin, matching the module's IO domain. Generate it from a PWM channel or an RTC clock output in the DTS.",
 WL_LDO_SW:"AP6212 internal buck SWITCH node, pin 21. Connects to pin 23 only through L4. Never tie this to a supply rail.",
 WL_LDO_IN:"AP6212 internal buck feedback input, pin 23. L4 from pin 21, C58 to ground. Corroborated against the FriendlyELEC NanoPi NEO Air and Rockchip PX30 reference designs.",
 AUD_AVREF:"SG2002 pin 3 — internal audio reference. Needs a 1 uF cap to ground even with audio unused.",
 ZQ_TP:"No external resistor on the reference board. First thing to probe when DDR init fails."
};
const GNDNETS=new Set(['GND','CHGND']);
const RAILS=new Set(['VBUS_5V','VDD3V3','VDD1V8','VDD1V35','VDDC','VDD18A_USB','WIFI_VDD','VDDC_RTC']);

const R=(r,v,x,y,rot,a,b,n)=>({ref:r,kind:'R',val:v,x,y,rot:rot||'V',nets:{A:a,B:b},note:n});
const C=(r,v,x,y,rot,a,b,n)=>({ref:r,kind:'C',val:v,x,y,rot:rot||'V',nets:{A:a,B:b},note:n});
const L=(r,v,x,y,rot,a,b,n)=>({ref:r,kind:'L',val:v,x,y,rot:rot||'H',nets:{A:a,B:b},note:n});
const FBd=(r,v,x,y,rot,a,b,n)=>({ref:r,kind:'FB',val:v,x,y,rot:rot||'H',nets:{A:a,B:b},note:n});
const Dd=(r,v,x,y,rot,a,k,n)=>({ref:r,kind:'D',val:v,x,y,rot:rot||'V',nets:{A:a,K:k},note:n});
const LEDd=(r,v,x,y,rot,a,k,n)=>({ref:r,kind:'LED',val:v,x,y,rot:rot||'V',nets:{A:a,K:k},note:n});
const SWd=(r,v,x,y,a,b,n)=>({ref:r,kind:'SW',val:v,x,y,rot:'H',nets:{A:a,B:b},note:n});
const TPd=(r,v,x,y,a,n)=>({ref:r,kind:'TP',val:v,x,y,rot:'V',nets:{A:a},note:n});
const IC=(r,nm,v,x,y,def,nets,n,soc)=>({ref:r,kind:'IC',name:nm,val:v,x,y,ic:def,nets,note:n,soc});
const BUCK={w:150,h:120,L:[['1','EN'],['4','IN']],R:[['3','SW'],['5','FB']],B:[['2','GND']]};
const LDOd={w:150,h:110,L:[['1','VIN'],['3','EN']],R:[['5','VOUT']],B:[['2','GND']]};

const SHEETS=[];

/* ============ 01 POWER ============ */
SHEETS.push({id:'01_Power',title:'Power tree',
 note:"Four rails from USB-C 5 V. The 3.3 V buck's enable is gated by PWR_SEQ2 — that single connection is the whole sequencing scheme. VDDQ and 1.8 V use RC soft-start on their enables, as the reference does.",
 comps:[
  IC('U1G','SG2002','power pins',1330,560,
   {w:210,h:820,L:[['9','VDDC'],['16','VDDC_2'],['50','VDDC_3'],['61','VDDC_4'],['71','VDDC_5'],
     ['31','VDDQ_DRAM1'],['32','VDDQ_1'],['33','VDDQ_2'],['34','VDDQ_DRAM2'],['13','VDDIO_SD0'],
     ['57','VDDIO_SD1'],['66','VDD33A_ETH'],['68','VDD18A_USB'],['36','VDDIO_RTC'],['82','VDD18A_MIPI'],
     ['5','VDD18A_AUD'],['37','VDDC_RTC'],['1','VSS18A_AUD'],['89','EPAD'],['42','PTEST'],
     ['41','PWR_SEQ2'],['38','PWR_VBAT_DET']]},
   {VDDC:'VDDC',VDDC_2:'VDDC',VDDC_3:'VDDC',VDDC_4:'VDDC',VDDC_5:'VDDC',
    VDDQ_DRAM1:'VDD1V35',VDDQ_1:'VDD1V35',VDDQ_2:'VDD1V35',VDDQ_DRAM2:'VDD1V35',
    VDDIO_SD0:'VDD3V3',VDDIO_SD1:'VDD3V3',VDD33A_ETH:'VDD3V3',VDD18A_USB:'VDD18A_USB',
    VDDIO_RTC:'VDD1V8',VDD18A_MIPI:'VDD1V8',VDD18A_AUD:'VDD1V8',VDDC_RTC:'VDDC_RTC',
    VSS18A_AUD:'GND',EPAD:'GND',PTEST:'GND',PWR_SEQ2:'PWR_SEQ2',PWR_VBAT_DET:'VBAT_DET'},
   "Every supply pin of the SG2002, one net label each. Pin 1 and the E-pad (89) are the only grounds.",1),
  IC('U6','ETA3414','0.95 V / 1.5 A',260,190,BUCK,
    {EN:'VBUS_5V',IN:'VBUS_5V',SW:'LX_VDDC',FB:'FB_VDDC',GND:'GND'},
    "CORE RAIL. 1220 mA TPU + 258 mA core = 1.48 A against a 1.5 A part — no headroom. Consider a 2 A+ device."),
  C('C47','22 uF 0805',130,285,'V','VBUS_5V','GND','Input bulk. Keep the cap-switch-inductor loop tiny.'),
  L('L2','1.0 uH 4 A',470,160,'H','LX_VDDC','VDDC','Core inductor, 1.5 A with headroom.'),
  C('C48','22 uF 0603',580,245,'V','VDDC','GND','Core output bulk.'),
  R('R46','11k8 1%',700,140,'V','VDDC','FB_VDDC','THE critical resistor. 0.6 x (11.8/20+1) = 0.954 V.'),
  R('R47','20k 1%',700,255,'V','FB_VDDC','GND','Lower FB leg.'),
  TPd('TP4','0.95 V',830,140,'VDDC','Scope every rail on a slow ramp before fitting the SoC.'),
  IC('U5','ETA3414','3.3 V / 1 A',260,470,BUCK,
    {EN:'PWR_SEQ2',IN:'VBUS_5V',SW:'LX_3V3',FB:'FB_3V3',GND:'GND'},
    'Enable gated by PWR_SEQ2. EN threshold 1.2 V max vs 1.8 V drive — 0.42 V margin, no level shift.'),
  C('C45','22 uF 0805',130,565,'V','VBUS_5V','GND','Input bulk.'),
  L('L1','2.2 uH 2 A',470,440,'H','LX_3V3','VDD3V3','3.3 V inductor.'),
  C('C46','22 uF 0603',580,525,'V','VDD3V3','GND','Output bulk.'),
  R('R44','100k 1%',700,420,'V','VDD3V3','FB_3V3','0.6 x (100/22.6+1) = 3.26 V. From the reference.'),
  R('R45','22k6 1%',700,535,'V','FB_3V3','GND','Lower FB leg.'),
  TPd('TP7','3.3 V',830,420,'VDD3V3','Verify this rises only AFTER 1.8 V.'),
  IC('U7','ETA3414','1.35 V / 1 A',260,750,BUCK,
    {EN:'EN_1V35',IN:'VBUS_5V',SW:'LX_1V35',FB:'FB_1V35',GND:'GND'},
    'DDR3L VDDQ. An LDO here would burn 0.5 W.'),
  C('C41','22 uF 0805',130,845,'V','VBUS_5V','GND','Input bulk.'),
  L('L3','2.2 uH 2 A',470,720,'H','LX_1V35','VDD1V35','VDDQ inductor.'),
  C('C49','22 uF 0603',580,805,'V','VDD1V35','GND','VDDQ output bulk. Ripple here is the first DDR suspect.'),
  R('R48','15k 1%',700,700,'V','VDD1V35','FB_1V35','0.6 x (15/12+1) = 1.35 V.'),
  R('R49','12k 1%',700,815,'V','FB_1V35','GND','Lower FB leg.'),
  R('R50','33k',110,700,'V','VBUS_5V','EN_1V35','RC soft-start on the VDDQ enable, with C50.'),
  C('C50','1 uF',110,815,'V','EN_1V35','GND','Soft-start timing cap.'),
  TPd('TP5','1.35 V',830,700,'VDD1V35','Rail test point.'),
  IC('U8','ETA5050','1.8 V / 300 mA',260,1000,LDOd,
    {VIN:'VDD3V3',EN:'EN_1V8',VOUT:'VDD1V8',GND:'GND'},
    'Fed from 3.3 V. 1.5 V drop at 150 mA = 0.23 W.'),
  R('R51','33k',110,945,'V','VDD3V3','EN_1V8','RC soft-start on the LDO enable, with C51.'),
  C('C51','1 uF',110,1055,'V','EN_1V8','GND','Soft-start timing cap.'),
  C('C52','4.7 uF',500,1000,'V','VDD1V8','GND','LDO output capacitor.'),
  C('C53','100 nF',590,1000,'V','VDD1V8','GND','LDO output bypass.'),
  TPd('TP6','1.8 V',830,945,'VDD1V8','Rail test point.'),
  C('C54','22 uF 0805',960,150,'V','VBUS_5V','GND','System input bulk at the 5 V entry.'),
  TPd('TP8','5 V',960,60,'VBUS_5V','Input rail test point.'),
  R('R16','30k 1%',960,860,'V','VBUS_5V','VBAT_DET','VBAT divider upper leg — 5 V through 30k/10k gives 1.25 V.'),
  R('R17','10k 1%',960,975,'V','VBAT_DET','GND','Lower leg. Chip will not start with this floating.'),
  FBd('FB2','600R @100MHz',640,930,'H','VDD1V8','VDD18A_USB','Isolates the USB PHY, PLL and Ethernet analog domain.'),
  C('C21','10 uF',760,1000,'V','VDD18A_USB','GND','Analog bulk.'),
  C('C22','100 nF',850,1000,'V','VDD18A_USB','GND','Analog bypass.'),
  C('C17','1 uF',1080,150,'V','VDDC_RTC','GND','Pin 37 is an internal LDO output — capacitors only.'),
  C('C18','100 nF',1170,150,'V','VDDC_RTC','GND','Pin 37 decoupling.')
 ]});

/* ============ 02 DECOUPLING ============ */
const dc=[];
[['C1','100 nF'],['C6','100 nF'],['C7','100 nF'],['C2','1 uF'],['C3','1 uF'],['C5','1 uF'],
 ['C4','4.7 uF'],['C8','4.7 uF'],['C9','10 uF'],['C10','10 uF']].forEach((e,i)=>
  dc.push(C(e[0],e[1],180+i*115,200,'V','VDDC','GND',
   i<3?'Ring 1 — under the package body, 2.5 mm from centre on the reference. 0201 there.':
   i<6?'Ring 2 — next ring out.':i<8?'Ring 3 — mid-field, 4.3-5.7 mm.':
   'Bulk — belongs AT THE REGULATOR (6.1 mm out), not at the SoC.')));
[['C11','100 nF'],['C12','100 nF'],['C13','1 uF'],['C14','4.7 uF'],['C15','4.7 uF'],['C16','10 uF']]
 .forEach((e,i)=>dc.push(C(e[0],e[1],180+i*115,430,'V','VDD1V35','GND','DDR rail bypass.')));
['C24','C26','C29','C30','C31','C32'].forEach((r,i)=>
  dc.push(C(r,'100 nF',180+i*115,660,'V','VDD1V8','GND','One per 1.8 V pin — the rail is merged but each pin still needs its own bypass.')));
['C20','C28'].forEach((r,i)=>dc.push(C(r,'10 uF',180+i*115,880,'V','VDD1V8','GND','1.8 V bulk.')));
['C33','C34','C35','C36'].forEach((r,i)=>
  dc.push(C(r,i<2?'10 uF':'100 nF',520+i*115,880,'V','VDD3V3','GND','3.3 V rail decoupling at the load.')));
SHEETS.push({id:'02_Decoupling',title:'Decoupling',
 note:"VDDC uses a graded cascade: 100 nF at the chip, 1 uF next, 4.7 uF mid-field, 10 uF at the regulator. Measured on the reference board, not guessed. X5R or X7R only — Y5V is prohibited by the design guide.",
 comps:dc});

/* ============ 03 STORAGE ============ */
SHEETS.push({id:'03_Storage',title:'microSD + SPI NOR',
 note:"SD0 is 3.3 V fixed — UHS-I is impossible because SD0 shares its IO rail with eMMC. All four boot straps live on this sheet: both flash straps and the two UART0 pull-ups.",
 comps:[
  IC('U1B','SG2002','SD0 + SPINOR + UART0',330,470,
   {w:220,h:700,R:[['6','SD0_CLK'],['7','SD0_CMD'],['8','SD0_D0'],['10','SD0_D1'],['11','SD0_D2'],
     ['12','SD0_D3'],['14','SD0_CD'],['15','SD0_PWR_EN'],['18','UART0_TX'],['19','UART0_RX'],
     ['21','SPINOR_SCK'],['22','SPINOR_MOSI'],['24','SPINOR_MISO'],['25','SPINOR_CS'],
     ['23','SPINOR_WP'],['20','SPINOR_HOLD']]},
   {SD0_CLK:'SD0_CLK',SD0_CMD:'SD0_CMD',SD0_D0:'SD0_D0',SD0_D1:'SD0_D1',SD0_D2:'SD0_D2',
    SD0_D3:'SD0_D3',SD0_CD:'SD0_CD',SD0_PWR_EN:'SD0_PWR_EN',UART0_TX:'UART0_TX',UART0_RX:'UART0_RX',
    SPINOR_SCK:'SPI_CLK',SPINOR_MOSI:'SPI_MOSI',SPINOR_MISO:'SPI_MISO',SPINOR_CS:'SPI_CS',
    SPINOR_WP:'SPI_WP',SPINOR_HOLD:'SPI_HOLD'},
   'SD0 and SPI NOR share the 3.3 V IO domain. Default mux on 20-25 is already SPINOR.',1),
  IC('U2','microSD','push-pull socket',1420,300,
   {w:160,h:340,L:[['1','CLK'],['2','CMD'],['3','DAT0'],['4','DAT1'],['5','DAT2'],['6','DAT3'],['7','CD'],['8','VDD'],['9','VSS']]},
   {CLK:'SD0_CLK_SD',CMD:'SD0_CMD',DAT0:'SD0_D0',DAT1:'SD0_D1',DAT2:'SD0_D2',DAT3:'SD0_D3',
    CD:'SD0_CD',VDD:'VDD3V3',VSS:'GND'},'Boot device. Hirose DM3AT-SF-PEJM5.'),
  R('R1','22R',900,150,'H','SD0_CLK','SD0_CLK_SD','Series damping at the SoC end.'),
  R('R2','10k',830,300,'V','SD0_CMD','VDD3V3','Command pull-up.'),
  R('R3','10k',920,300,'V','SD0_D0','VDD3V3','Data pull-up.'),
  R('R4','10k',1010,300,'V','SD0_D1','VDD3V3','Data pull-up.'),
  R('R5','10k',1100,300,'V','SD0_D2','VDD3V3','Data pull-up.'),
  R('R6','10k',1190,300,'V','SD0_D3','VDD3V3','Data pull-up.'),
  R('R7','10k',1280,300,'V','SD0_CD','VDD3V3','Card-detect pull-up.'),
  IC('U3','W25Q128','16 MB SOIC-8',1420,800,
   {w:160,h:220,L:[['1','CS'],['6','CLK'],['5','DI']],R:[['2','DO'],['3','WP'],['7','HOLD']],T:[['8','VCC']],B:[['4','GND']]},
   {CS:'SPI_CS',CLK:'SPI_CLK_F',DI:'SPI_MOSI',DO:'SPI_MISO',WP:'SPI_WP',HOLD:'SPI_HOLD',VCC:'VDD3V3',GND:'GND'},
   'W25Q128JVSIQ(1T) — vendor validated list. The (1T) suffix is specified.'),
  R('R8','22R',900,660,'H','SPI_CLK','SPI_CLK_F','Series damping. SPI_CLK needs individual ground shielding.'),
  R('R9','4.7k',830,800,'V','SPI_CS','VDD3V3','Chip-select pull-up.'),
  R('R10','4.7k',920,800,'V','SPI_HOLD','VDD3V3','HOLD# pull-up.'),
  R('R11','4.7k',830,980,'V','UART0_TX','VDD3V3',"MANDATORY. Pull-down = ROM fail mode. Reference labels it 'Do not Delete!!!'."),
  R('R12','4.7k',920,980,'V','UART0_RX','VDD3V3','The reference pulls RX up too.'),
  R('R13','4.7k DNP',1050,980,'V','SPI_MOSI','VDD3V3','EMMC_DAT0 pull-UP. Unpopulated — internal pull-up used.'),
  R('R14','4.7k DNP',1160,980,'V','SPI_WP','GND','EMMC_DAT3 pull-DOWN. Fit ONLY for SPI NOR boot.'),
  C('C37','10 uF',1280,700,'V','VDD3V3','GND','Local bulk at the socket.'),
  C('C38','100 nF',1280,980,'V','VDD3V3','GND','Flash bypass at the VCC pin.')
 ]});

/* ============ 04 USB ============ */
SHEETS.push({id:'04_USB',title:'USB 2.0 Type-C',
 note:"Sink only, no PD. CC1 and CC2 need SEPARATE 5.1k resistors — one shared resistor is a classic fatal error. The ESD array sits INLINE, not as a stub, and belongs as close to the connector as possible.",
 comps:[
  IC('U1D','SG2002','USB',1330,400,
   {w:200,h:200,L:[['69','USB_DP'],['70','USB_DM'],['60','USB_VBUS_DET']]},
   {USB_DP:'USB_DP',USB_DM:'USB_DM',USB_VBUS_DET:'USB_VBUS_DET'},
   'USB_VBUS_DET: low = host, high = device. 1.8 V domain input.',1),
  IC('J2','USB-C','16-pin sink',230,380,
   {w:160,h:280,R:[['A4/B4','VBUS'],['A6/B6','DP'],['A7/B7','DM'],['A5','CC1'],['B5','CC2'],['A1/B1','GND']]},
   {VBUS:'VBUS_5V',DP:'USB_DP_CON',DM:'USB_DM_CON',CC1:'CC1',CC2:'CC2',GND:'GND'},
   'GCT USB4085-GF-A. Tie A/B duplicate pins together.'),
  R('R37','5k1',480,600,'V','CC1','GND','Type-C sink advertisement. Separate resistor per CC pin.'),
  R('R38','5k1','570',600,'V','CC2','GND','Second, independent CC pull-down.'),
  IC('D1','USBLC6','ESD 3.5 pF max',720,330,
   {w:150,h:190,L:[['1','IO1_IN'],['3','IO2_IN']],R:[['6','IO1_OUT'],['4','IO2_OUT']],T:[['5','VBUS']],B:[['2','GND']]},
   {IO1_IN:'USB_DP_CON',IO2_IN:'USB_DM_CON',IO1_OUT:'USB_DP_MID',IO2_OUT:'USB_DM_MID',VBUS:'VBUS_5V',GND:'GND'},
   'USBLC6-2SC6. Tracks to I/O, VBUS and GND must be as short as possible — the datasheet shows parasitic inductance turning a 31 V clamp into 319 V.'),
  R('R39','5R1',1000,270,'H','USB_DP_MID','USB_DP','Series damping at the CONNECTOR end, not the SoC.'),
  R('R40','5R1',1000,380,'H','USB_DM_MID','USB_DM','Series damping at the connector end.'),
  R('R41','100k',1000,620,'V','VBUS_5V','USB_VBUS_DET','VBUS sense divider upper leg.'),
  R('R42','47k',1000,735,'V','USB_VBUS_DET','GND','Lower leg.'),
  C('C42','10 uF',230,750,'V','VBUS_5V','GND','Input bulk at the connector.'),
  C('C43','100 nF',330,750,'V','VBUS_5V','GND','Input bypass.')
 ]});

/* ============ 05 ETHERNET ============ */
SHEETS.push({id:'05_Ethernet',title:'Ethernet 10/100',
 note:"5.1 ohm series into the magnetics is required — surge immunity and EMI. NO RC filter on the pairs: it wrecks the eye diagram. CHGND is deliberately a separate net: an isolated chassis island bridged to GND only through R34 and C39.",
 comps:[
  IC('U1E','SG2002','EPHY',250,350,
   {w:210,h:320,R:[['62','ETH_TXP'],['63','ETH_TXM'],['64','ETH_RXP'],['65','ETH_RXM'],['48','PWR_GPIO1'],['49','PWR_GPIO2']]},
   {ETH_TXP:'EPHY_RXN',ETH_TXM:'EPHY_RXP',ETH_RXP:'EPHY_TXN',ETH_RXM:'EPHY_TXP',
    PWR_GPIO1:'ETH_LNK',PWR_GPIO2:'ETH_SPD'},
   'Package pin names and net names are CROSSED by the vendor — pin 62 is named PAD_ETH_TXP but carries EPHY_RXN. Do not correct it.',1),
  R('R26','5R1',620,240,'H','EPHY_TXP','ETH_TXP_M','Series into the magnetics. Required, not optional.'),
  R('R27','5R1',620,330,'H','EPHY_TXN','ETH_TXN_M','Series into the magnetics.'),
  R('R28','5R1',620,420,'H','EPHY_RXP','ETH_RXP_M','Series into the magnetics.'),
  R('R29','5R1',620,510,'H','EPHY_RXN','ETH_RXN_M','Series into the magnetics.'),
  IC('J1','RJ45','integrated magnetics',960,370,
   {w:170,h:320,L:[['1','TXP'],['2','TXN'],['3','RXP'],['4','RXN'],['5','CT'],['6','LNK'],['7','SPD']],B:[['8','SHLD']]},
   {TXP:'ETH_TXP_M',TXN:'ETH_TXN_M',RXP:'ETH_RXP_M',RXN:'ETH_RXN_M',CT:'BOB',
    LNK:'ETH_LNK_A',SPD:'ETH_SPD_A',SHLD:'CHGND'},'HanRun HR911105A. No copper pour under the magnetics.'),
  R('R30','75R 1%',620,760,'V','ETH_TXP_M','BOB','Bob Smith termination.'),
  R('R31','75R 1%',710,760,'V','ETH_TXN_M','BOB','Bob Smith termination.'),
  R('R32','75R 1%',800,760,'V','ETH_RXP_M','BOB','Bob Smith termination.'),
  R('R33','75R 1%',890,760,'V','ETH_RXN_M','BOB','Bob Smith termination.'),
  C('C39','1 nF 2 kV 1206',1010,760,'V','BOB','CHGND','High-voltage coupling to chassis. Rating and 1206 body both matter.'),
  R('R34','1M',1120,760,'V','CHGND','GND','Bleeds the chassis island to digital ground.'),
  Dd('DA1','SMBJ14A',1230,760,'V','CHGND','GND','Transient suppression on the chassis node.'),
  R('R35','1k',700,150,'H','ETH_LNK','ETH_LNK_A','Link LED. Driven from a 1.8 V pin.'),
  R('R36','1k',700,60,'H','ETH_SPD','ETH_SPD_A','Speed LED, 1.8 V drive.')
 ]});

/* ============ 06 WIRELESS ============ */
SHEETS.push({id:'06_Wireless',title:'WiFi + antenna',
